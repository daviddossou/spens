<% content_for :title, t('.title') %>
<div class="page-container page-container--narrow">
  <%= render Ui::PageHeaderComponent.new do %>
    <p class="page-header__subtitle"><%= t('.subtitle') %></p>
  <% end %>
  <div class="page-content">
    <% if @spaces.any? %>
      <div class="spaces-list">
        <% @spaces.each do |space| %>
          <%= render Spaces::CardComponent.new(space: space, active: current_space&.id == space.id) %>
        <% end %>
      </div>
    <% else %>
      <%= render Ui::EmptyStateComponent.new(classes: "empty-state") do %>
        <%= render Ui::IconComponent.new(:archive, classes: "empty-state__icon") %>
        <h3><%= t('.no_spaces_title') %></h3>
        <p><%= t('.no_spaces_message') %></p>
      <% end %>
    <% end %>
  </div>
</div>
<%= render Ui::FabComponent.new(url: new_space_path, label: t('.add_new_space')) %>
