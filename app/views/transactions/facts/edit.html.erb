<%# One fact, one selector: opened from a detail-page row, saved through the
    regular transactions#update (full-form path, ledger-safe). Category and account
    use the same picker rows as the transaction form. %>
<%= turbo_frame_tag "modal" do %>
  <div class="page-container page-container--narrow">
    <header class="page-header fact-sheet__header">
      <h2 class="page-header__title"><%= t(".title_#{@fact}") %></h2>
    </header>

    <div class="page-content">
      <%= form_with model: @form, url: transaction_path(id: @transaction.id), method: :patch,
                    data: { turbo_frame: "_top" } do |f| %>
        <div class="fact-sheet__field">
          <% case @fact %>
          <% when "category" %>
            <%= render Forms::PickerFieldComponent.new(
              form: f, field: :transaction_type_name,
              label: t('transactions.form.transaction_type_label'), title: t('picker.category'),
              placeholder: t('transactions.form.transaction_type_placeholder'),
              rows: picker_category_rows(@form.transaction_type_options, planned_names: @form.planned_type_names),
              allow_create: true, grouped: true) %>
          <% when "account" %>
            <%= render Forms::PickerFieldComponent.new(
              form: f, field: :account_name,
              label: t('transactions.form.account_label'), title: t('picker.account'),
              placeholder: t('transactions.form.account_placeholder'),
              rows: picker_account_rows(@form.account_suggestions, current_space.currency),
              allow_create: true) %>
          <% when "date" %>
            <%= render Forms::InputFieldComponent.new(
              form: f,
              field: :transaction_date,
              type: :date_field,
              label: t('transactions.form.date_label', default: t('transactions.show.date'))
            ) %>
          <% end %>
        </div>

        <%= render Ui::ButtonComponent.new(
          text: t('.save'),
          variant: :primary,
          size: :lg,
          full_width: true,
          type: :submit
        ) %>
      <% end %>
    </div>
  </div>
<% end %>
