<%
  row = MovementRow.new(@transaction, formatter: ->(amount) { money(amount.abs) })
  editable = %w[income expense].include?(@transaction.transaction_type.kind)
%>
<% content_for :page_title, row.title %>

<%# Contextual top bar: back, the composed title, and a ⋯ menu (edit-in-form +
    delete) — same pattern as the debt/goal detail pages. %>
<% content_for :header do %>
  <%= render Navigation::DetailHeaderComponent.new(back_url: dashboard_path, title: row.title) do |header| %>
    <% header.with_action do %>
      <%= render Ui::ActionMenuComponent.new(label: t('.more_actions'), classes: nil) do %>

          <%= link_to t('.edit'), edit_transaction_path(id: @transaction.id),
                class: "header-menu__item", data: { turbo_frame: "modal" } %>
          <%= link_to t('.delete'), transaction_path(id: @transaction.id),
                class: "header-menu__item header-menu__item--danger",
                data: { turbo_method: :delete, turbo_confirm: t('.delete_confirmation') } %>

<% end %>
    <% end %>
  <% end %>
<% end %>

<div class="page-container page-container--narrow">
  <div class="page-content">
    <!-- Hero: family icon, the signed amount, the composed line -->
    <%= render Transactions::MovementHeroComponent.new(transaction: @transaction, row: row) %>

    <!-- The facts. Each editable one opens its own selector — one gesture to fix. -->
    <%= render Transactions::FactsComponent.new(transaction: @transaction, editable: editable) %>

    <!-- Quiet metadata -->
    <p class="movement-meta">
      <%= t('.created_at') %> <%= l(@transaction.created_at, format: :short) %><% if @transaction.updated_at != @transaction.created_at %> · <%= t('.updated_at') %> <%= l(@transaction.updated_at, format: :short) %><% end %>
    </p>
  </div>
</div>

<%= render Ui::FabComponent.new(url: new_transaction_path(account_id: @transaction.account_id),
                                label: t('.add_transaction')) %>
