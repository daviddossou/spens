<% content_for :title, t('auth.registrations.sign_up') %>
<% content_for :subtitle do %>
  <%= t('auth.registrations.or') %>
  <%= link_to t('auth.registrations.sign_in_link'), new_user_session_path, class: "font-medium text-primary hover:text-secondary" %>
<% end %>

<%= form_with model: @user, url: user_registration_path, method: :post, class: "space-y-6",
              data: { controller: "onboarding--landing-country", onboarding__landing_country_confirmed_value: false } do |f| %>
  <%= render Forms::ErrorsComponent.new(object: @user, detailed: true) %>

  <%# Where the new space will live: the landing's pick and the browser's time zone. %>
  <%= hidden_field_tag :landing_country, nil, data: { onboarding__landing_country_target: "country" } %>
  <%= hidden_field_tag :landing_currency, nil, data: { onboarding__landing_country_target: "currency" } %>
  <%= hidden_field_tag :time_zone, nil, data: { onboarding__landing_country_target: "timeZone" } %>

  <%= render Forms::InputFieldComponent.new(
    form: f,
    field: :first_name,
    type: :text_field,
    label: t('auth.registrations.first_name'),
    autocomplete: "given-name",
    required: true
  ) %>

  <%= render Forms::InputFieldComponent.new(
    form: f,
    field: :email,
    type: :email_field,
    label: t('auth.registrations.email'),
    autocomplete: "email",
    required: true
  ) %>

  <%= render "shared/turnstile" %>

  <%= render Ui::ButtonComponent.new(
    form: f,
    text: t('auth.registrations.continue'),
    variant: :primary,
    full_width: true
  ) %>
<% end %>
