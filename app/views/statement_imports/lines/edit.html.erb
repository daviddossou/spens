<%# Editing a line: the usual transaction form, without the phrase band. "Valider" only
    updates the draft line. %>
<%= turbo_frame_tag "modal" do %>
  <div class="page-container page-container--narrow">
    <%= render Ui::PageHeaderComponent.new(classes: "transaction-form__header") do %>
      <h2 class="transaction-form__title si-edit-title"><%= @line.label.presence || t('statement_imports.review.unlabelled') %></h2>
      <p class="transaction-form__subtitle">
        <%= t("statement_imports.review.kind_label.#{@form.kind}", default: @form.kind.to_s.humanize) %> · <%= l(@form.transaction_date, format: :day_month) %>
      </p>
      <% if @line.flags.include?("foreign_currency") %>
        <p class="si-form-note"><%= t('statement_imports.review.foreign_amount', amount: money(@line.amount.abs, @line.currency)) %></p>
      <% end %>
    <% end %>

    <%= turbo_frame_tag "transaction_form" do %>
      <div class="page-content">
        <%= render "transactions/form",
              form_url: statement_import_line_path(statement_import_id: @import.id, id: @line.id), form_method: :patch,
              cta_label: t('statement_imports.review.validate'),
              kind_switch_url: ->(kind) { edit_statement_import_line_path(statement_import_id: @import.id, id: @line.id, **@form.kind_params(kind)) } %>
        <%# The visible way to take a line out (the swipe is only a shortcut): keyboard and screen readers. %>
        <%= button_to ignore_statement_import_line_path(statement_import_id: @import.id, id: @line.id), params: { via: "form" },
              class: "si-ignore-line", form_class: "si-ignore-line-form", form: { data: { turbo_frame: "_top" } } do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88"/></svg>
          <%= t('statement_imports.review.ignore_line') %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
