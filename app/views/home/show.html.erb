<% content_for :page_title, t('.dashboard_title') %>

<div class="page-container page-container--narrow">
  <div class="page-content">

    <!-- Hero: the one glanceable number -->
    <%= link_to accounts_path, class: "stat-card-link stat-card-link--quiet", "aria-label": t('.stats.view_accounts') do %>
      <%= render Ui::StatCardComponent.new(
        label: t('.stats.total_balance'),
        value: @total_balance,
        currency: @currency,
        variant: :hero,
        icon: tag.svg(fill: "none", stroke: "currentColor", viewBox: "0 0 24 24") do
          tag.path(stroke_linecap: "round", stroke_linejoin: "round", "stroke-width": "1.8",
                   d: "M3 7a2 2 0 012-2h12a2 2 0 012 2v1h1a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2V7zm15 5h-3a1.5 1.5 0 100 3h3")
        end
      ) %>
    <% end %>

    <!-- Secondary stats -->
    <div class="stat-cards">
      <% savings_goal = current_space.monthly_savings_goal %>
      <%= link_to edit_space_path(id: current_space.id), class: "stat-card-link",
                  "aria-label": savings_goal.present? ? t('.stats.edit_goal') : t('.stats.set_goal') do %>
        <%= render Ui::StatCardComponent.new(
          label: t('.stats.saved_this_month'),
          sublabel: savings_goal.present? ? t('.stats.goal_sublabel', goal: strip_tags(smart_format_money(savings_goal, @currency))) : t('.stats.set_goal_sublabel'),
          value: @saved_this_month,
          currency: @currency,
          variant: :compact,
          trend: @saved_this_month.positive? ? :positive : (@saved_this_month.negative? ? :caution : nil)
        ) %>
      <% end %>
      <%= link_to debts_path(direction: "lent"), class: "stat-card-link", "aria-label": t('.stats.view_lent') do %>
        <%= render Ui::StatCardComponent.new(
          label: t('.stats.owed_to_me'),
          value: @owed_to_me,
          currency: @currency,
          variant: :compact,
          trend: @owed_to_me.positive? ? :positive : nil
        ) %>
      <% end %>
      <%= link_to debts_path(direction: "borrowed"), class: "stat-card-link", "aria-label": t('.stats.view_borrowed') do %>
        <%= render Ui::StatCardComponent.new(
          label: t('.stats.i_owe'),
          value: @i_owe,
          currency: @currency,
          variant: :compact,
          trend: @i_owe.positive? ? :negative : nil
        ) %>
      <% end %>
    </div>

    <!-- Search -->
    <%= form_with url: dashboard_path, method: :get, role: "search",
                  class: "transactions-search",
                  data: { controller: "search-form sticky",
                          sticky_stuck_class: "is-stuck",
                          turbo_frame: "transactions_timeline",
                          turbo_action: "advance" } do %>
      <div class="transactions-search__field">
        <svg class="transactions-search__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"/>
        </svg>
        <%= search_field_tag :q, @search_query,
              class: "form-input transactions-search__input",
              placeholder: t('.search.placeholder'),
              "aria-label": t('.search.aria_label'),
              autocomplete: "off",
              data: { search_form_target: "input",
                      action: "input->search-form#search keydown.esc->search-form#clear" } %>
        <button type="button"
                class="transactions-search__clear hidden"
                data-search-form-target="clear"
                data-action="search-form#clear"
                aria-label="<%= t('.search.clear') %>">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    <% end %>

    <!-- Transactions timeline (frame so live search swaps only the list) -->
    <%= turbo_frame_tag "transactions_timeline",
          data: { controller: "infinite-scroll",
                  infinite_scroll_url_value: dashboard_path(q: @search_query.presence),
                  infinite_scroll_page_value: @has_more ? @page + 1 : 0 } do %>
      <div id="transactions-container" class="transactions-timeline">
        <%= render partial: "shared/transactions_list", locals: { grouped_transactions: @grouped_transactions } %>
      </div>

      <!-- Loading Spinner -->
      <div id="loading-spinner"
           data-infinite-scroll-target="spinner"
           class="dashboard__spinner hidden">
        <div class="dashboard__spinner-icon"></div>
        <p class="dashboard__spinner-text"><%= t('.loading') %></p>
      </div>

      <!-- Load More Trigger (Invisible) -->
      <% if @has_more %>
        <div id="infinite-scroll-trigger"
             data-infinite-scroll-target="trigger"
             class="dashboard__load-trigger"></div>
      <% end %>

      <!-- Empty States -->
      <% if @transactions.empty? && @page == 1 %>
        <% if @search_query.present? %>
          <div class="transactions-search__empty">
            <p class="transactions-search__empty-title"><%= t('.search.no_results', query: @search_query) %></p>
            <p class="transactions-search__empty-hint"><%= t('.search.no_results_hint') %></p>
          </div>
        <% else %>
          <%= render partial: "empty_state" %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>

<%= render Ui::FabComponent.new(url: new_quick_entry_path, label: t('.quick_add'), icon: :bolt, secondary: true) %>
<%= render Ui::FabComponent.new(url: new_transaction_path, label: t('.add_transaction')) %>
