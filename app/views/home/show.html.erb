<% content_for :page_title, t('.dashboard_title') %>

<div class="page-container page-container--narrow">
  <div class="page-content">

    <%# Only for spaces that went through the journey's first step (the savings projection). %>
    <%= render "journey_card" if current_space.monthly_income.present? %>

    <!-- Hero: the one glanceable number -->
    <%= link_to accounts_path, class: "stat-card-link stat-card-link--quiet", "aria-label": t('.stats.view_accounts') do %>
      <%= render Ui::StatCardComponent.new(
        label: t('.stats.total_balance'),
        value: @total_balance,
        currency: @currency,
        variant: :hero,
        abbreviate: false,
        footnote: (@set_aside_total.positive? ? t('.stats.set_aside_footnote', amount: money(@set_aside_total, @currency)) : nil),
        icon: tag.svg(fill: "none", stroke: "currentColor", viewBox: "0 0 24 24") do
          tag.path(stroke_linecap: "round", stroke_linejoin: "round", "stroke-width": "1.8",
                   d: "M3 7a2 2 0 012-2h12a2 2 0 012 2v1h1a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2V7zm15 5h-3a1.5 1.5 0 100 3h3")
        end
      ) %>
    <% end %>

    <!-- Money in / out this month — two verifiable facts, side by side -->
    <%= render Transactions::FlowSummaryComponent.new(currency: @currency, money_in: @money_in, money_out: @money_out) %>

    <!-- Debts summary — one neutral block, cumulative, links to Debts -->
    <% if @owed_to_me.positive? || @i_owe.positive? %>
      <%= link_to debts_path, class: "debt-summary", "aria-label": t('.stats.view_debts') do %>
        <div class="debt-summary__half">
          <span class="debt-summary__label"><%= t('.stats.owed_to_me') %></span>
          <span class="debt-summary__value"><%= money(@owed_to_me, @currency) %></span>
        </div>
        <div class="debt-summary__half">
          <span class="debt-summary__label"><%= t('.stats.i_owe') %></span>
          <span class="debt-summary__value"><%= money(@i_owe, @currency) %></span>
        </div>
        <span class="debt-summary__chevron" aria-hidden="true">
          <%= render Ui::IconComponent.new(:chevron_right) %>
        </span>
      <% end %>
    <% end %>

    <!-- Search -->
    <%= render Transactions::SearchComponent.new(query: @search_query) %>

    <!-- Transactions timeline (frame so live search swaps only the list) -->
    <%= turbo_frame_tag "transactions_timeline",
          data: { controller: "infinite-scroll",
                  infinite_scroll_url_value: dashboard_path(q: @search_query.presence),
                  infinite_scroll_page_value: @has_more ? @page + 1 : 0 } do %>
      <div id="transactions-container" class="transactions-timeline">
        <%= render Transactions::TimelineComponent.new(grouped_transactions: @grouped_transactions) %>
      </div>

      <!-- Loading Spinner -->
      <%= render Transactions::PaginationComponent.new(has_more: @has_more) %>

      <!-- Empty States -->
      <% if @transactions.empty? && @page == 1 %>
        <% if @search_query.present? %>
          <%= render Ui::EmptyStateComponent.new(classes: "transactions-search__empty") do %>
            <p class="transactions-search__empty-title"><%= t('.search.no_results', query: @search_query) %></p>
            <p class="transactions-search__empty-hint"><%= t('.search.no_results_hint') %></p>
          <% end %>
        <% else %>
          <%= render partial: "empty_state" %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>

<%= render Ui::FabComponent.new(url: new_transaction_path, label: t('.add_transaction')) %>
