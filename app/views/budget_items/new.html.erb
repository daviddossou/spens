<% content_for :title, t('.title') %>

<%= turbo_frame_tag "modal" do %>
  <div class="page-container page-container--narrow">
    <% raw_month = l(@form.starts_on, format: "%B") %>
    <% month_label = I18n.locale == :fr ? "#{raw_month.match?(/\A[aeiouâàéèêëîïôûùhy]/i) ? "d'" : "de "}#{raw_month}" : raw_month.capitalize %>
    <% sub_key = @form.transfer_kind? ? "transfer" : (@form.debt_kind? ? "debt" : (@form.kind == "income" ? "income" : "expense")) %>
    <header class="page-header budget-item-form__header">
      <h2 class="budget-item-form__title"><%= t(".new_title") %></h2>
      <p class="budget-item-form__subtitle"><%= t(".new_subtitle_#{sub_key}", month: month_label) %></p>
    </header>

    <div class="page-content">
      <%= form_with model: @form, url: budget_items_path(month: params[:month].presence), method: :post do |f| %>
        <%= render 'form', f: f %>
      <% end %>
    </div>
  </div>
<% end %>
