<%= render "shared/form_errors", object: @form %>

<%= f.hidden_field :starts_on %>

<%
  currency_symbol = get_currency_symbol(current_space.currency)
  freqs = %w[monthly quarterly yearly]
  current_freq = freqs.include?(@form.frequency) ? @form.frequency : "monthly"
  period_labels = freqs.index_with { |fr| t("budgets.form.per_#{fr}") }
  period_short = freqs.index_with { |fr| t("budgets.form.per_short_#{fr}") }
  summary_freq = freqs.index_with { |fr| t("budgets.form.summary_#{fr}") }
  summary_end = { never: t("budgets.form.summary_never"), date: t("budgets.form.summary_until") }
  summary_rollover = { on: t("budgets.form.summary_rollover_on"), off: t("budgets.form.summary_rollover_off") }
%>

<div class="budget-item-form" data-controller="budget-line"
     data-budget-line-period-labels-value="<%= period_labels.to_json %>"
     data-budget-line-period-short-value="<%= period_short.to_json %>"
     data-budget-line-summary-freq-value="<%= summary_freq.to_json %>"
     data-budget-line-summary-end-value="<%= summary_end.to_json %>"
     data-budget-line-summary-rollover-value="<%= summary_rollover.to_json %>"
     data-budget-line-currency-value="<%= currency_symbol %>"
     data-budget-line-locale-value="<%= I18n.locale %>"
     data-budget-line-rollover-example-value="<%= t('budgets.form.rollover_example_line') %>"
     data-budget-line-rollover-empty-value="<%= t('budgets.form.rollover_example_empty') %>"
     data-budget-line-next-month-value="<%= l(@form.starts_on >> 1, format: '%B') %>"
     data-budget-line-cta-template-value="<%= t('budgets.form.cta_add_plan_amount', value: '%{value}') %>"
     data-budget-line-cta-empty-value="<%= t('budgets.form.cta_need_amount') %>"
     data-budget-line-kind-value="<%= @form.category_kind? ? 'category' : (@form.transfer_kind? ? 'transfer' : 'debt') %>"
     data-budget-line-cta-no-category-value="<%= t('budgets.form.cta_no_category') %>"
     data-budget-line-cta-no-from-account-value="<%= t('budgets.form.cta_no_from_account') %>"
     data-budget-line-cta-no-to-account-value="<%= t('budgets.form.cta_no_to_account') %>"
     data-budget-line-cta-no-person-value="<%= t('budgets.form.cta_no_person') %>"
     data-action="change->budget-line#syncSummary input->budget-line#syncSummary">

  <%# Type selector — one active (coloured), three neutral. %>
  <% unless @form.editing? %>
    <% tiles = [
         { value: "expense", kind: "expense" },
         { value: "income", kind: "income" },
         { value: "transfer", kind: "transfer" },
         { value: "debt", kind: "debt_in" }
       ] %>
    <div class="budget-item-form__kind">
      <div class="kind-selector kind-selector--quad kind-selector--mono" role="radiogroup" aria-label="<%= t('budgets.form.kind_label') %>">
        <% tiles.each do |tile| %>
          <% selected = tile[:value] == "debt" ? @form.debt_kind? : @form.kind == tile[:value] %>
          <%= link_to new_budget_item_path(kind: tile[:kind], month: params[:month].presence),
                      role: "radio", "aria-checked": selected.to_s,
                      class: "kind-option kind-option--#{tile[:value]}#{' kind-option--selected' if selected}" do %>
            <span class="kind-option__icon kind-option__icon--<%= tile[:value] %>" aria-hidden="true">
              <%= transaction_icon_svg(tile[:value]) %>
            </span>
            <span class="kind-option__label"><%= t("budgets.form.kind_#{tile[:value]}") %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Amount as the hero: enter the number first, big and centred. %>
  <div class="budget-amount">
    <div class="budget-amount__field">
      <%= f.number_field :amount, class: "budget-amount__input",
            value: (@form.amount && (@form.amount % 1 == 0 ? @form.amount.to_i : @form.amount.to_f)),
            step: "0.01", min: "0.01", inputmode: "decimal",
            placeholder: t("budgets.form.amount_placeholder"),
            autofocus: !@form.editing?,
            aria: { label: t("budgets.form.amount_label") },
            data: { budget_line_target: "amount", action: "input->budget-line#syncSummary" } %>
      <span class="budget-amount__currency"><%= currency_symbol %></span>
    </div>
    <span class="budget-amount__period" data-budget-line-target="periodLabel"><%= period_labels[current_freq] %></span>
  </div>

  <%# Category / transfer / debt — what the line is about. %>
  <% if @form.category_kind? %>
    <%= f.hidden_field :kind %>
    <div class="budget-item-form__type">
      <%= render Forms::PickerFieldComponent.new(
        form: f, field: :transaction_type_name, label: t('budgets.form.type_label'),
        title: t('picker.category'), placeholder: t('budgets.form.type_placeholder'),
        rows: picker_category_rows(@form.transaction_type_options, planned_names: @form.planned_type_names),
        allow_create: true, grouped: true) %>
    </div>
  <% elsif @form.transfer_kind? %>
    <%= f.hidden_field :kind %>
    <div class="transfer-block">
      <div class="transfer-block__row">
        <span class="transfer-block__prefix"><%= t('budgets.form.transfer_from') %></span>
        <div class="transfer-block__field">
          <%= render Forms::PickerFieldComponent.new(
            form: f, field: :from_account_name, label: "",
            title: t('picker.account_from'), id: "transfer-from",
            placeholder: t('budgets.form.from_account_placeholder'),
            rows: picker_account_rows(@form.account_suggestions, current_space.currency),
            allow_create: true, chain_to: "#transfer-to", chain_reason: t('picker.same_account'), chain_label: t('picker.from_short')) %>
        </div>
      </div>
      <div class="transfer-block__row">
        <span class="transfer-block__prefix"><%= t('budgets.form.transfer_to') %></span>
        <div class="transfer-block__field">
          <%= render Forms::PickerFieldComponent.new(
            form: f, field: :to_account_name, label: "",
            title: t('picker.account_to'), id: "transfer-to",
            placeholder: t('budgets.form.to_account_placeholder'),
            rows: picker_account_rows(@form.account_suggestions, current_space.currency),
            allow_create: true) %>
        </div>
      </div>
    </div>
  <% else %>
    <%
      debt_labels = {
        someone: t('budgets.form.debt_someone'),
        i_repay: t('budgets.form.debt_i_repay'), they_repay: t('budgets.form.debt_they_repay'),
        effect_out: t('budgets.form.debt_effect_out'), effect_in: t('budgets.form.debt_effect_in'),
        you_owe: t('budgets.form.debt_you_owe'), owes_you: t('budgets.form.debt_owes_you'),
        settled: t('budgets.form.debt_settled_html')
      }
    %>
    <div class="budget-item-form__debt" data-controller="budget-debt"
         data-budget-debt-kinds-by-name-value="<%= @form.debt_kinds_by_name.to_json %>"
         data-budget-debt-summaries-value="<%= @form.debt_summaries_by_name.to_json %>"
         data-budget-debt-currency-value="<%= currency_symbol %>"
         data-budget-debt-starts-on-value="<%= @form.starts_on.strftime('%Y-%m-%d') %>"
         data-budget-debt-locale-value="<%= I18n.locale %>"
         data-budget-debt-current-name-value="<%= @form.contact_name %>"
         data-budget-debt-labels-value="<%= debt_labels.to_json %>">
      <%= f.hidden_field :kind, data: { budget_debt_target: "kindInput" } %>

      <%= render Forms::NameFieldComponent.new(
        form: f, field: :contact_name, label: t('budgets.form.debt_who'),
        placeholder: t('budgets.form.contact_placeholder'),
        suggestions: @form.debt_person_suggestions, see_all_title: t('picker.people'),
        field_data: { action: "input->budget-debt#onPersonChange change->budget-debt#onPersonChange" }) %>

      <p class="debt-balance" data-budget-debt-target="balance" hidden></p>

      <%# Four sentences reduced to two cards — the money direction is written out
          and the effect shown live. %>
      <div class="debt-cards" role="radiogroup" aria-label="<%= t('budgets.form.direction_label') %>">
        <% [ [ "debt_out", "i_repay", "effect_out", "expense" ], [ "debt_in", "they_repay", "effect_in", "income" ] ].each do |kind, title_key, effect_key, icon| %>
          <button type="button" class="debt-card<%= ' debt-card--selected' if @form.kind == kind %>"
                  data-budget-debt-target="card" data-kind="<%= kind %>" data-effect="<%= effect_key %>"
                  data-title="<%= title_key %>" data-action="click->budget-debt#selectCard"
                  role="radio" aria-checked="<%= (@form.kind == kind).to_s %>">
            <span class="debt-card__icon debt-card__icon--<%= icon %>" aria-hidden="true"><%= transaction_icon_svg(icon) %></span>
            <span class="debt-card__text">
              <span class="debt-card__title" data-budget-debt-target="cardTitle"></span>
              <span class="debt-card__effect" data-budget-debt-target="cardEffect"></span>
            </span>
          </button>
        <% end %>
      </div>

      <%# The app knows the balance, so once you set a monthly amount it works out
          when the debt clears and ends the recurring line there on its own. %>
      <p class="debt-settled" data-budget-debt-target="settled" hidden></p>
    </div>
  <% end %>

  <%# Vital or comfort? — an explicit choice, not a buried checkbox (expense only). %>
  <% if @form.kind == "expense" %>
    <div class="vc-choice">
      <span class="vc-choice__question"><%= t('budgets.form.vital_confort_question') %></span>
      <div class="vc-choice__cards">
        <% [ [ true, "vital" ], [ false, "confort" ] ].each do |val, key| %>
          <label class="vc-card">
            <%= f.radio_button :essential, val, class: "vc-card__input" %>
            <span class="vc-card__title"><%= t("budgets.form.#{key}_card_title") %></span>
            <span class="vc-card__sub"><%= t("budgets.form.#{key}_card_sub") %></span>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Advanced settings, folded away but announcing what's active. %>
  <details class="budget-modify">
    <summary class="budget-modify__summary">
      <span class="budget-modify__text">
        <span class="budget-modify__main" data-budget-line-target="summaryMain"></span>
        <% if @form.kind == "expense" %>
          <span class="budget-modify__aside" data-budget-line-target="summaryRollover"></span>
        <% elsif @form.debt_kind? %>
          <span class="budget-modify__aside"><%= t('budgets.form.debt_vital_note') %></span>
        <% end %>
      </span>
      <span class="budget-modify__toggle"><%= t('budgets.form.modify') %></span>
    </summary>

    <div class="budget-modify__body">
      <%= f.hidden_field :frequency, value: current_freq, data: { budget_line_target: "frequency" } %>

      <%# Each setting is one label and its control — no definitions. %>
      <div class="budget-setting">
        <span class="budget-setting__q"><%= t('budgets.form.freq_question') %></span>
        <div class="seg-group">
          <% freqs.each do |fr| %>
            <button type="button" class="seg<%= ' seg--active' if fr == current_freq %>"
                    data-budget-line-target="freqSeg" data-frequency="<%= fr %>"
                    data-action="budget-line#setFrequency"><%= t("budgets.form.freq_#{fr}") %></button>
          <% end %>
        </div>
      </div>

      <div class="budget-setting">
        <span class="budget-setting__q"><%= t('budgets.form.end_question') %></span>
        <div class="pill-choice">
          <button type="button" class="pill<%= ' pill--active' if @form.ends_on.blank? %>"
                  data-budget-line-target="endSeg" data-end="never"
                  data-action="budget-line#setEnd"><%= t('budgets.form.end_never') %></button>
          <button type="button" class="pill<%= ' pill--active' if @form.ends_on.present? %>"
                  data-budget-line-target="endSeg" data-end="date"
                  data-action="budget-line#setEnd"><%= t('budgets.form.end_dated') %></button>
        </div>
        <div class="budget-setting__date<%= ' hidden' if @form.ends_on.blank? %>" data-budget-line-target="endField">
          <%= f.date_field :ends_on, value: @form.ends_on, class: "form-input",
                data: { budget_line_target: "endInput", action: "budget-line#syncSummary" } %>
        </div>
      </div>

      <% if @form.kind == "expense" %>
        <label class="budget-toggle">
          <span class="budget-toggle__text">
            <span class="budget-toggle__label"><%= t('budgets.form.rollover_toggle_label') %></span>
            <%# The numeric example replaces the explanation paragraph. %>
            <span class="budget-toggle__sub" data-budget-line-target="rolloverExample"></span>
          </span>
          <span class="budget-toggle__switch">
            <%= f.check_box :rollover, class: "budget-toggle__input",
                  data: { budget_line_target: "rollover", action: "budget-line#syncSummary" } %>
            <span class="budget-toggle__track" aria-hidden="true"></span>
          </span>
        </label>
      <% end %>
    </div>
  </details>

  <%# A transfer moves money between your accounts — it changes neither spending
      nor savings, so its impact is spelled out as nil. %>
  <% if @form.transfer_kind? %>
    <div class="transfer-impact">
      <span class="transfer-impact__title"><%= t('budgets.form.transfer_impact_title') %></span>
      <p class="transfer-impact__body"><%= t('budgets.form.transfer_impact_body_html') %></p>
    </div>
  <% end %>

  <div class="budget-item-form__actions">
    <%= render Ui::ButtonComponent.new(
      text: @form.editing? ? t('budget_items.edit.save') : t('budgets.form.cta_add_plan'),
      type: :submit, variant: :primary, size: :lg, full_width: true,
      disabled: !@form.editing?,
      data: { budget_line_target: "cta" }) %>

    <% if @form.editing? %>
      <%= render Ui::ButtonComponent.new(
        text: t('budget_items.edit.stop_budgeting'),
        url: budget_item_path(id: @budget_item.id, month: params[:month].presence),
        variant: :danger, size: :lg, full_width: true, method: :delete,
        data: { "turbo-confirm" => t('budget_items.edit.stop_confirmation') }) %>
    <% end %>
  </div>
</div>
