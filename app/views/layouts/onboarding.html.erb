<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} | " : "" %>Spens</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#3F51B5">

    <%# Self-hosted fonts (app/assets/fonts), latin files preloaded. %>
    <%= preload_link_tag asset_path("geist-latin.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= preload_link_tag asset_path("plus-jakarta-sans-latin.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>

    <%# One bundled stylesheet, built by the tailwind CLI from app/assets/tailwind/application.css %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>


    <%= javascript_importmap_tags %>
    <%= render "shared/posthog" %>
    <%= render "shared/meta_pixel" %>
  </head>

  <body style="background-color: var(--color-off-white);">
    <main class="main-container">
      <%= render Ui::FlashMessageComponent.new(flash) %>
      <%= render "shared/impersonation_banner" %>
      <%= yield %>
    </main>
  </body>
</html>
