<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title).presence || "Admin · Spens" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Self-hosted fonts (app/assets/fonts), latin files preloaded. %>
    <%= preload_link_tag asset_path("geist-latin.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= preload_link_tag asset_path("plus-jakarta-sans-latin.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin-body">
    <header class="admin-topbar">
      <div class="admin-topbar__inner">
        <%= link_to "Spens Admin", admin_root_path, class: "admin-topbar__brand" %>
        <nav class="admin-nav" aria-label="Admin">
          <% admin_nav_groups.each_with_index do |group, i| %>
            <% if i.positive? %><span class="admin-nav__sep" aria-hidden="true"></span><% end %>
            <% group.each do |item| %>
              <%= link_to item[:path],
                    class: class_names("admin-nav__link", "admin-nav__link--active" => current_page?(item[:path])) do %>
                <%= item[:label] %><% if item[:count].to_i.positive? %><span class="admin-nav__count"><%= item[:count] %></span><% end %>
              <% end %>
            <% end %>
          <% end %>
        </nav>
        <div class="admin-topbar__meta">
          <span class="admin-topbar__email"><%= current_user.email %></span>
          <%= link_to t("admin.nav.exit"), root_path, class: "admin-topbar__exit" %>
        </div>
      </div>
    </header>

    <main class="admin-main">
      <%= render Ui::FlashMessageComponent.new(flash) %>
      <%= yield %>
    </main>
  </body>
</html>
