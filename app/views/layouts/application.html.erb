<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Spens" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="Spens">
    <meta name="description" content="Track your money simply">
    <meta property="og:title" content="Spens">
    <meta property="og:description" content="Track your money simply">
    <meta property="og:image" content="/icon-512.png">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="Spens">
    <meta name="twitter:description" content="Track your money simply">
    <meta name="twitter:image" content="/icon-512.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#3F51B5">

    <%# Geist + Plus Jakarta Sans are self-hosted (app/assets/fonts): no third-party
        request on a cold start. The latin files are preloaded so text renders in the
        right face on the first paint. %>
    <%= preload_link_tag asset_path("geist-latin.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= preload_link_tag asset_path("plus-jakarta-sans-latin.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>

    <%# One bundled stylesheet, built by the tailwind CLI from app/assets/tailwind/application.css %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>


    <%= javascript_importmap_tags %>
    <%= render "shared/posthog" %>
  </head>

  <body style="background-color: var(--color-off-white);">
    <% if user_signed_in? %>
      <% if content_for?(:header) %>
        <%= content_for(:header) %>
      <% else %>
        <%= render Navigation::HeaderComponent.new(
          page_title: content_for(:page_title).presence || content_for(:title).presence || "Spens",
          current_user: current_user,
          current_space: current_space,
          params: params
        ) %>
      <% end %>
    <% end %>

    <main class="main-container<%= ' main-container--with-shell' if user_signed_in? %>">
      <!-- Flash messages -->
      <%= render Ui::FlashMessageComponent.new(flash) %>
      <%= render "shared/impersonation_banner" %>

      <%= yield %>
    </main>

    <% if user_signed_in? %>
      <div hidden
           data-controller="time-zone"
           data-time-zone-current-value="<%= current_user.time_zone %>"
           data-time-zone-url-value="<%= time_zone_path %>"></div>

      <%= render Pwa::InstallBannerComponent.new %>
      <%= render Navigation::BottomNavComponent.new(current_path: request.path) %>

      <!-- Bottom Sheet Modal -->
      <%= render Ui::BottomSheetComponent.new() %>

      <%# Sibling of the sheet, never inside it: opening a choice must not
          unmount the form underneath (Tour 32c). %>
      <%= render Forms::PickerLayerComponent.new %>
    <% end %>
  </body>
</html>
