<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("landing.meta.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <%= render "shared/seo", title: content_for(:title) || t("landing.meta.title"),
                             description: content_for(:description) || t("landing.meta.description") %>
    <%= yield :head %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <meta name="theme-color" content="#2c3044">

    <%# Self-hosted fonts (app/assets/fonts), latin files preloaded. %>
    <%= preload_link_tag asset_path("geist-latin.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= preload_link_tag asset_path("plus-jakarta-sans-latin.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>

    <script nonce="<%= content_security_policy_nonce %>">
      // Installed PWA: skip the landing and go straight to sign-in.
      if (window.matchMedia("(display-mode: standalone)").matches || window.navigator.standalone === true) {
        window.location.replace("<%= new_user_session_path %>");
      }
    </script>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= render "shared/posthog" %>
    <%= render "shared/meta_pixel" %>
  </head>

  <body class="landing-body">
    <%= yield %>
    <%= render Privacy::ConsentBannerComponent.new %>
  </body>
</html>
