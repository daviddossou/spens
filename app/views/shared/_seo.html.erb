<%# Search and link-sharing metadata, shared by every layout.
    locals: title, description (default: the product pitch). %>
<% description = local_assigns[:description].presence || t("seo.description") %>
<meta name="description" content="<%= description %>">
<% if seo_indexable? %>
  <link rel="canonical" href="<%= seo_url %>">
  <% seo_alternates.each do |hreflang, href| %>
    <link rel="alternate" hreflang="<%= hreflang %>" href="<%= href %>">
  <% end %>
<% else %>
  <meta name="robots" content="noindex">
<% end %>
<meta property="og:site_name" content="Spens">
<meta property="og:type" content="website">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:url" content="<%= seo_url %>">
<meta property="og:locale" content="<%= t("seo.og_locale") %>">
<meta property="og:image" content="<%= seo_image_url %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="<%= t("seo.image_alt") %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= description %>">
<meta name="twitter:image" content="<%= seo_image_url %>">
