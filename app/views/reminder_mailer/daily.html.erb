<% font = "font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;" %>
<h2 style="color: #333; <%= font %> margin-bottom: 16px;"><%= t('reminders.daily.title') %></h2>

<p style="color: #555; <%= font %> font-size: 16px; line-height: 1.5;"><%= t('reminders.daily.body') %></p>

<div style="text-align: center; margin: 24px 0;">
  <a href="<%= @open_url %>" style="background-color: #3F51B5; color: #fff; padding: 12px 32px; text-decoration: none; border-radius: 8px; <%= font %> font-size: 16px; font-weight: 600;">
    <%= t('reminders.daily.cta') %>
  </a>
</div>

<p style="color: #888; <%= font %> font-size: 14px; line-height: 1.5;">
  <%= t('reminders.daily.stop_html', link: link_to(t('reminders.daily.stop_link'), @stop_url, style: "color: #888;")) %>
</p>
