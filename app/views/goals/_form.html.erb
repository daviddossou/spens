<%= render Forms::ErrorsComponent.new(object: form.object) %>

<% currency_symbol = get_currency_symbol(current_space.currency) %>

<div class="goal-form__container">
  <%# The target is the hero: big, typed first. "0" keeps its size while empty. %>
  <%= render Forms::AmountFieldComponent.new(
        form: form, field: :target_amount, value: form.object.target_amount,
        currency: currency_symbol, autofocus: !form.object.persisted?, aria_label: t(".target_aria"),
        data: { goal_form_target: "amount", action: "input->goal-form#onAmount" }) do |amount| %>
    <% amount.with_period do %>
      <span class="budget-amount__period"><%= t(".target_label") %></span>
    <% end %>
  <% end %>

  <%# What it's for — a motivating name. No asterisk; the button names what's missing. %>
  <div class="goal-form__field">
    <%= render Forms::InputFieldComponent.new(
      form: form, field: :goal_name, label: t(".name_label"), required: false,
      placeholder: t(".name_placeholder")) %>
  </div>

  <%# Where the money sits — locked once the goal exists. %>
  <div class="goal-form__field">
    <% if disable_account_field %>
      <%= form.hidden_field :account_name %>
    <% end %>
    <% unless disable_account_field %>
      <%= render Forms::PickerFieldComponent.new(
        form: form, field: :account_name, label: t(".account_label"), title: t('picker.account'),
        placeholder: t(".account_placeholder"), help_text: t(".account_help"),
        rows: picker_account_rows(@form.account_suggestions, current_space.currency, savings_first: true),
        allow_create: true,
        field_data: { goal_form_target: "accountName" }) %>
    <% end %>
  </div>

  <%# Already put aside — the starting point. %>
  <div class="goal-form__field">
    <%= render Forms::InputFieldComponent.new(
      form: form, field: :current_balance, type: :number_field, label: t(".saved_label"),
      required: false, prepend: currency_symbol, step: "0.01", min: "0", placeholder: "0",
      value: (form.object.current_balance && (form.object.current_balance % 1 == 0 ? form.object.current_balance.to_i : form.object.current_balance.to_f)),
      field_data: { goal_form_target: "currentBalance" }) %>
  </div>

  <%# For when — pills that set a deadline without opening a calendar. %>
  <div class="goal-form__field">
    <span class="form-label"><%= t(".deadline_label") %></span>
    <%= render Forms::SegmentedChoiceComponent.new(classes: "pill-choice", options: [ { label: t(".deadline_6m"), data: { deadline_mode: "m6" } }, { label: t(".deadline_1y"), data: { deadline_mode: "y1" } }, { label: t(".deadline_date"), data: { deadline_mode: "other" } }, { label: t(".deadline_none"), data: { deadline_mode: "none" } } ],
 data: { goal_form_target: "deadlinePill", action: "goal-form#setDeadline" }) %>
    <div class="goal-form__date hidden" data-goal-form-target="deadlineField">
      <%= render Forms::InputFieldComponent.new(form: form, field: :deadline, type: :date_field, bare: true, aria: { label: t("goals.form.deadline_label") },
            data: { goal_form_target: "deadlineInput", action: "input->goal-form#onDeadlineInput" }) %>
    </div>
    <%# The monthly rhythm the deadline implies, live. %>
    <p class="goal-form__rhythm" data-goal-form-target="rhythm" hidden></p>
  </div>
</div>
