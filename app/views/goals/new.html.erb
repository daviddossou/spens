<% content_for :title, t('.title') %>

<%= turbo_frame_tag "modal" do %>
  <div class="page-container page-container--narrow">
    <%= render Ui::PageHeaderComponent.new(classes: "goal-form__header") do %>
      <h2 class="goal-form__title"><%= t('.title') %></h2>
      <p class="goal-form__subtitle"><%= t('.subtitle') %></p>
    <% end %>

    <div class="page-content">
      <%= form_with model: @form, url: goals_path, method: :post, class: "goal-form",
            data: {
              controller: "goal-form",
              action: "input->goal-form#onField change->goal-form#onField",
              goal_form_currency_value: get_currency_symbol(current_space.currency),
              goal_form_locale_value: I18n.locale,
              goal_form_cta_empty_value: t('.cta_empty'),
              goal_form_cta_no_name_value: t('.cta_no_name'),
              goal_form_cta_no_account_value: t('.cta_no_account'),
              goal_form_cta_ready_value: t('.cta_ready'),
              goal_form_rhythm_template_value: t('goals.form.rhythm')
            } do |f| %>
        <%= render 'form', form: f, disable_account_field: false %>

        <div class="goal-form__actions">
          <%= render Ui::ButtonComponent.new(text: t('.cta_empty'), type: :submit, size: :lg, disabled: true, data: { goal_form_target: "cta" }) %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
