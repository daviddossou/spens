<% content_for :title, t('.title', account_name: @account.name) %>

<%= turbo_frame_tag "modal" do %>
  <div class="page-container page-container--narrow">
    <header class="page-header goal-form__header">
      <h2 class="goal-form__title"><%= t('.title', account_name: @account.name) %></h2>
      <p class="goal-form__subtitle"><%= t('.subtitle') %></p>
    </header>

    <div class="page-content">
      <%= form_with model: @form, url: goal_path(id: @account.id), method: :patch, class: "goal-form",
            data: {
              controller: "goal-form",
              action: "input->goal-form#onField change->goal-form#onField",
              goal_form_currency_value: get_currency_symbol(current_space.currency),
              goal_form_locale_value: I18n.locale,
              goal_form_cta_empty_value: t('goals.new.cta_empty'),
              goal_form_cta_no_name_value: t('goals.new.cta_no_name'),
              goal_form_cta_no_account_value: t('goals.new.cta_no_account'),
              goal_form_cta_ready_value: t('.update_goal'),
              goal_form_rhythm_template_value: t('goals.form.rhythm')
            } do |f| %>
        <%= render 'form', form: f, disable_account_field: true %>

        <div class="goal-form__actions">
          <button type="submit" class="btn btn-primary btn-lg" data-goal-form-target="cta">
            <%= t('.update_goal') %>
          </button>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
