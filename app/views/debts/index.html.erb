<% content_for :title, t(".heading") %>

<div class="page-container page-container--narrow">
  <div class="page-content debts-index">
    <% has_ongoing = @owed_to_me.any? || @i_owe.any? %>

    <% if has_ongoing %>
      <!-- Two totals, each the sum of the nets on that side — David counts once. -->
      <div class="debts-totals">
        <div class="debts-totals__cell">
          <span class="debts-totals__label"><%= t(".owed_to_me_label") %></span>
          <span class="debts-totals__value debts-totals__value--lent">
            <%= smart_format_money(@total_owed_to_me, current_space.currency, sign: :never, threshold: 1_000) %>
          </span>
          <span class="debts-totals__meta">
            <%= @owed_to_me.any? ? t(".people_count", count: @owed_to_me.size) : t(".nothing_ongoing") %>
          </span>
        </div>
        <div class="debts-totals__divider"></div>
        <div class="debts-totals__cell">
          <span class="debts-totals__label"><%= t(".i_owe_label") %></span>
          <span class="debts-totals__value debts-totals__value--borrowed">
            <%= smart_format_money(@total_i_owe, current_space.currency, sign: :never, threshold: 1_000) %>
          </span>
          <span class="debts-totals__meta">
            <%= @i_owe.any? ? t(".people_count", count: @i_owe.size) : t(".nothing_ongoing") %>
          </span>
        </div>
      </div>

      <% if @owed_to_me.any? %>
        <section class="debts-section">
          <header class="debts-section__head">
            <h2 class="debts-section__title debts-section__title--lent"><%= t(".section_lent") %></h2>
            <span class="debts-section__hint"><%= t(".section_hint") %></span>
          </header>
          <div class="debts-list">
            <% @owed_to_me.each do |relation| %>
              <%= render "relation_row", relation: relation %>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @i_owe.any? %>
        <section class="debts-section">
          <header class="debts-section__head">
            <h2 class="debts-section__title debts-section__title--borrowed"><%= t(".section_borrowed") %></h2>
            <span class="debts-section__hint"><%= t(".section_hint") %></span>
          </header>
          <div class="debts-list">
            <% @i_owe.each do |relation| %>
              <%= render "relation_row", relation: relation %>
            <% end %>
          </div>
        </section>
      <% end %>

    <% elsif @closed_debts.any? %>
      <%# Nothing outstanding, but there's history — reassure, then keep it below. %>
      <div class="debts-settled">
        <span class="debts-settled__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
          </svg>
        </span>
        <h2 class="debts-settled__title"><%= t(".settled_title") %></h2>
        <p class="debts-settled__message"><%= t(".settled_message") %></p>
      </div>
    <% else %>
      <%# First day: a few starters instead of a blank slate. %>
      <div class="goals-empty">
        <h2 class="goals-empty__title"><%= t(".starters_title") %></h2>
        <p class="goals-empty__lead"><%= t(".starters_lead") %></p>
        <div class="goals-starters">
          <% debt_starters.each do |starter| %>
            <%= render "starter", starter: starter %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @closed_debts.any? %>
      <!-- Closed debts are archive: collapsed to a single line, out of the way of living debts. -->
      <details class="debts-closed">
        <summary class="debts-closed__summary">
          <span class="debts-closed__check" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
            </svg>
          </span>
          <span class="debts-closed__label">
            <%= t(".closed_count", count: @closed_debts.size) %>
            <span class="debts-closed__breakdown"><%= closed_debts_breakdown(@closed_debts) %></span>
          </span>
          <span class="debts-closed__chevron" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"></path>
            </svg>
          </span>
        </summary>
        <div class="debts-closed__list">
          <% @closed_debts.each do |debt| %>
            <%= link_to debt_path(id: debt.id), class: "debt-closed-row" do %>
              <span class="debt-closed-row__main">
                <span class="debt-closed-row__name">
                  <%= debt.name %>
                  <% if debt.written_off? %>
                    <span class="debt-closed-row__tag"><%= closed_debt_short_tag(debt) %></span>
                  <% end %>
                </span>
                <span class="debt-closed-row__sub"><%= closed_debt_row_subtitle(debt) %></span>
              </span>
              <span class="debt-closed-row__amount <%= 'debt-closed-row__amount--struck' if debt.written_off? %>">
                <%= smart_format_money(debt.total_lent, current_space.currency, sign: :never) %>
              </span>
            <% end %>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>
</div>

<%= render Ui::FabComponent.new(url: new_debt_path, label: t(".add_new")) %>
