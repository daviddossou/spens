<%= render Forms::ErrorsComponent.new(object: form.object) %>

<% currency_symbol = get_currency_symbol(current_space.currency) %>
<% editing = form.object.persisted? %>

<div class="account-form__container"
     data-controller="account-kind"
     data-action="input->account-kind#infer change->account-kind#infer"
     data-account-kind-names-value="<%= Account.set_aside_names.to_json %>"
     data-account-kind-manual-value="<%= editing %>"
     data-account-kind-everyday-value="<%= t('.everyday_line_html') %>"
     data-account-kind-set-aside-value="<%= t('.set_aside_line_html') %>">
  <%# The balance is the hero: how much is in it today, typed first. %>
  <%= render Forms::AmountFieldComponent.new(
        form: form, field: :current_balance, value: form.object.current_balance,
        currency: currency_symbol, autofocus: !editing, aria_label: t('.amount_label'),
        data: { account_form_target: "amount", action: "input->account-form#onAmount" }) %>

  <%# Naming a new account is a choice first (bank, Mobile Money, cash…), typed only when
      nothing fits; renaming an existing one stays free text. %>
  <div class="account-form__field">
    <% if editing %>
      <%= render Forms::NameFieldComponent.new(
        form: form, field: :account_name, label: t('.name_label'),
        placeholder: t('.name_placeholder'),
        suggestions: @form.name_suggestions,
        field_data: { account_form_target: "name", action: "input->account-form#onField" }) %>
    <% else %>
      <%# The chips stay as the one-tap shortcut under the picker. %>
      <div data-controller="name-chips" data-action="change->name-chips#render"
           data-name-chips-suggestions-value="<%= @form.name_suggestions.to_json %>">
        <%= render Forms::PickerFieldComponent.new(
          form: form, field: :account_name, label: t('.name_label'),
          title: t('picker.account'), placeholder: t('.name_picker_placeholder'),
          rows: @form.name_suggestions.map { |name|
            icon, label = picker_icon_and_label(name)
            { value: name, label: label, icon: icon }
          },
          allow_create: true, focus_search: true,
          field_data: { account_form_target: "name", name_chips_target: "input" }) %>
        <div class="name-chips" data-name-chips-target="chips" hidden></div>
      </div>
    <% end %>
  </div>

  <%# Spending or savings? is deduced from the name, one tap to flip it. %>
  <div class="account-kind">
    <%= form.hidden_field :set_aside, data: { account_kind_target: "input" } %>
    <p class="account-kind__text" data-account-kind-target="text" aria-live="polite">
      <%= form.object.set_aside ? t('.set_aside_line_html') : t('.everyday_line_html') %>
    </p>
    <button type="button" class="account-kind__change" data-action="account-kind#toggle"><%= t('.kind_change') %></button>
  </div>

  <% if editing %>
    <%# The gap opens only once the amount is touched: how far off, and why —
        no cause is required, "I'm not sure, recalibrate" is the default. %>
    <%= render Accounts::BalanceAdjustmentComponent.new(account: @account) %>
  <% end %>

  <%# A one-line recap of what pressing the button will do. %>
  <p class="account-form__recap" data-account-form-target="recap" hidden></p>
</div>
