<%= render Forms::ErrorsComponent.new(object: form.object) %>

<% currency_symbol = get_currency_symbol(current_space.currency) %>
<% editing = form.object.persisted? %>

<div class="account-form__container">
  <%# The balance is the hero: how much is in it today, typed first. %>
  <%= render Forms::AmountFieldComponent.new(
        form: form, field: :current_balance, value: form.object.current_balance,
        currency: currency_symbol, min: "0", autofocus: !editing, aria_label: t('.amount_label'),
        data: { account_form_target: "amount", action: "input->account-form#onAmount" }) %>

  <%# Name — the existing searchable field, kept as is. No asterisk. %>
  <div class="account-form__field">
    <%= render Forms::NameFieldComponent.new(
      form: form, field: :account_name, label: t('.name_label'),
      placeholder: t('.name_placeholder'),
      suggestions: @form.name_suggestions,
      field_data: { account_form_target: "name", action: "input->account-form#onField" }) %>
  </div>

  <%# Spending or savings? — an explicit two-card choice (same pattern as the
      budget's Vital/Confort). A savings account counts as "mis de côté". %>
  <div class="vc-choice">
    <span class="vc-choice__question"><%= t('.kind_question') %></span>
    <div class="vc-choice__cards">
      <% [ [ false, "everyday" ], [ true, "set_aside" ] ].each do |val, key| %>
        <%= render Ui::SelectableCardComponent.new(
  item: { value: val, name: t(".#{key}_card_title"), description: t(".#{key}_card_sub") },
  native_radio: true, form: form, field: :set_aside, selected: nil,
  css_class: "vc-card", input_options: { class: "vc-card__input" }) %>
      <% end %>
    </div>
  </div>

  <% if editing %>
    <%# The gap opens only once the amount is touched: how far off, and why —
        no cause is required, "I'm not sure, recalibrate" is the default. %>
    <%= render Accounts::BalanceAdjustmentComponent.new(account: @account) %>
  <% end %>

  <%# A one-line recap of what pressing the button will do. %>
  <p class="account-form__recap" data-account-form-target="recap" hidden></p>
</div>
