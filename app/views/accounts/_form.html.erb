<%= render 'shared/form_errors', object: form.object %>

<div class="account-form__container">
    <!-- Account Name Field with Autocomplete -->
    <div class="account-form__field">
      <% if disable_account_field %>
        <%= form.hidden_field :account_name %>
      <% end %>

      <%= render Forms::InputFieldComponent.new(
        form: form,
        field: :account_name,
        label: t('.account_label'),
        required: true,
        autocomplete: !(disable_account_field.presence || false),
        autocomplete_options: @form.account_suggestions,
        default_autocomplete_options: @form.default_account_suggestions,
        allow_create: !(disable_account_field.presence || false),
        placeholder: t('.account_placeholder'),
        help_text: t('.account_help'),
        disabled: (disable_account_field || false),
        field_data: { tom_select_currency_value: get_currency_symbol(current_space.currency) }
      ) %>
    </div>

    <!-- Current Balance Field -->
    <div class="account-form__field">
      <%= render Forms::InputFieldComponent.new(
        form: form,
        field: :current_balance,
        type: :number_field,
        label: t('.current_balance_label'),
        required: true,
        prepend: get_currency_symbol(current_space.currency),
        step: "0.01",
        min: "0",
        placeholder: "0.00",
        help_text: t('.current_balance_help')
      ) %>
    </div>

    <!-- Reserved money — feeds the dashboard's "dont X mis de côté" -->
    <div class="account-form__field">
      <%= render Forms::CheckboxFieldComponent.new(
        form: form,
        field: :set_aside,
        label: t('.set_aside_label'),
        help_text: t('.set_aside_help'),
        checked: @form.set_aside
      ) %>
    </div>
  </div>
