<% content_for :title, t('.title') %>

<%= turbo_frame_tag "modal" do %>
  <div class="page-container page-container--narrow">
    <%= render Ui::PageHeaderComponent.new(classes: "account-form__header") do %>
      <h2 class="account-form__title"><%= t('.title') %></h2>
      <p class="account-form__subtitle"><%= t('.subtitle') %></p>
    <% end %>

    <div class="page-content">
      <%= form_with model: @form, url: accounts_path, method: :post, class: "account-form",
            data: {
              controller: "account-form",
              action: "input->account-form#onField change->account-form#onField",
              account_form_currency_value: get_currency_symbol(current_space.currency),
              account_form_locale_value: I18n.locale,
              account_form_mode_value: "create",
              account_form_total_value: @accounts_total.to_f,
              account_form_cta_empty_value: t('.cta_empty'),
              account_form_cta_ready_value: t('.cta_ready'),
              account_form_recap_create_value: t('.recap')
            } do |f| %>
        <%= render 'form', form: f %>

        <div class="account-form__actions">
          <%= render Ui::ButtonComponent.new(text: t('.cta_empty'), type: :submit, size: :lg, disabled: true, data: { account_form_target: "cta" }) %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
