<% content_for :title, t('.title') %>

<div class="page-container page-container--narrow">
  <div class="page-content">
    <% if @everyday.any? || @set_aside.any? %>
      <%# The list answers "how much do I have?" first: the total, and the part
          already promised to goals. %>
      <div class="accounts-total">
        <p class="accounts-total__label"><%= t('.total_label') %></p>
        <p class="accounts-total__amount"><%= account_money(@total) %></p>
        <% if @reserved.positive? %>
          <p class="accounts-total__reserved"><%= t('.reserved_html', amount: tag.strong(account_money(@reserved), class: "accounts-total__reserved-amount")) %></p>
        <% end %>
      </div>

      <% if @everyday.any? %>
        <section class="accounts-group">
          <header class="accounts-group__head">
            <h2 class="accounts-group__title"><%= t('.everyday') %></h2>
            <span class="accounts-group__total"><%= account_money(@everyday_total) %></span>
          </header>
          <div class="accounts-list">
            <% @everyday.each do |account| %>
              <%= render Accounts::RowComponent.new(account: account) %>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @set_aside.any? %>
        <section class="accounts-group">
          <header class="accounts-group__head">
            <h2 class="accounts-group__title"><%= t('.set_aside') %></h2>
            <span class="accounts-group__total"><%= account_money(@reserved) %></span>
          </header>
          <div class="accounts-list">
            <% @set_aside.each do |account| %>
              <%= render Accounts::RowComponent.new(account: account) %>
            <% end %>
          </div>
        </section>
      <% end %>
    <% else %>
      <%= render Ui::EmptyStateComponent.new(classes: "empty-state") do %>
        <%= render Ui::IconComponent.new(:wallet, classes: "empty-state__icon") %>
        <h3><%= t('.no_accounts_title') %></h3>
        <p><%= t('.no_accounts_message') %></p>
      <% end %>
    <% end %>

    <% if @archived.any? %>
      <%# Archived accounts are kept for their history — collapsed, out of the way. %>
      <details class="accounts-archived">
        <summary class="accounts-archived__summary">
          <span class="accounts-archived__label"><%= t('.archived_count', count: @archived.size) %></span>
          <%= render Ui::IconComponent.new(:chevron_down, classes: "accounts-archived__chevron") %>
        </summary>
        <div class="accounts-archived__list">
          <% @archived.each do |account| %>
            <%= render Accounts::ArchivedRowComponent.new(account: account) %>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>
</div>

<%= render Ui::FabComponent.new(url: new_account_path, label: t('.add_new_account')) %>
