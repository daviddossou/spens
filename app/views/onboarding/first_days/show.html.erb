<% content_for :title, t('.title') %>
<% add_link = { turbo_frame: "modal" } %>

<div class="onboarding-step">
  <%= render Onboarding::StepHeaderComponent.new(step: 3, title: t('.title')) %>

  <div class="onboarding-step__body">
    <% if @recap %>
      <% _, top_name = picker_icon_and_label(@categories.keys.first) %>
      <div class="gather-total">
        <p class="gather-total__label"><%= t('.today') %></p>
        <p class="gather-total__amount"><%= account_money(@total) %></p>
        <p class="gather-total__count"><%= t('.mostly', category: top_name.downcase) %></p>
      </div>

      <div class="analyses-card day-recap">
        <%= render Analytics::DistributionComponent.new(
              rows: @categories.map { |name, amount| [ name, amount ] },
              limit: 4, more_label: t('.other_categories', count: [ @categories.size - 4, 0 ].max)) %>
      </div>

      <p class="savings-projection__note"><%= t('.congrats', count: @expenses.size) %></p>

      <%= link_to new_transaction_path(kind: "expense"), class: "gather-add", data: add_link do %>
        <span aria-hidden="true">+</span> <%= t('.add_another') %>
      <% end %>

      <div class="onboarding-step__actions">
        <%= button_to t('.done_for_today'), onboarding_first_days_path, method: :patch,
                      class: "btn btn-primary btn-lg btn-full-width onboarding-step__cta" %>
      </div>
    <% elsif @expenses.any? %>
      <div class="gather-total">
        <p class="gather-total__label"><%= t('.noted_today') %></p>
        <p class="gather-total__amount"><%= account_money(@total) %></p>
        <p class="gather-total__count"><%= t('.expenses', count: @expenses.size) %></p>
      </div>

      <div class="day-list">
        <% @expenses.each do |expense| %>
          <%= render TransactionItemComponent.new(transaction: expense, link: false) %>
        <% end %>
      </div>

      <p class="savings-projection__note"><%= t('.congrats', count: @expenses.size) %></p>

      <%= link_to new_transaction_path(kind: "expense"), class: "gather-add", data: add_link do %>
        <span aria-hidden="true">+</span> <%= t('.add_another') %>
      <% end %>

      <div class="onboarding-step__actions">
        <%= button_to t('.done_for_today'), onboarding_first_days_path, method: :patch,
                      class: "btn btn-primary btn-lg btn-full-width onboarding-step__cta" %>
      </div>
    <% else %>
      <div class="gather-intro">
        <h2 class="gather-intro__title"><%= t('.intro_title') %></h2>
        <p class="gather-intro__text"><%= t('.intro_text', amount: money(100)) %></p>
      </div>

      <div class="gather-empty">
        <h3 class="gather-empty__title"><%= t('.empty_title') %></h3>
        <p class="gather-empty__text"><%= t('.empty_text') %></p>
      </div>

      <div class="onboarding-step__actions">
        <%= link_to t('.add_first'), new_transaction_path(kind: "expense"),
                    class: "btn btn-primary btn-lg btn-full-width onboarding-step__cta", data: add_link %>
        <%= button_to t('.skip'), onboarding_first_days_path, method: :patch,
                      class: "onboarding-step__secondary", form_class: "onboarding-step__secondary-form" %>
      </div>
    <% end %>
  </div>
</div>
