<%= form_with model: @form,
              url: onboarding_profile_setups_path,
              method: :patch,
              class: "onboarding-form",
              data: { controller: "onboarding--profile-prefill" } do |f| %>
  <%= render Forms::ErrorsComponent.new(object: @form) %>

  <div class="form-grid">
    <%= render Onboarding::ProfileSetups::PickerFieldComponent.new(
      form: f,
      field: :country
    ) %>

    <%= render Onboarding::ProfileSetups::PickerFieldComponent.new(
      form: f,
      field: :currency
    ) %>

    <%= render Onboarding::ProfileSetups::PickerFieldComponent.new(
      form: f,
      field: :income_frequency
    ) %>

    <%= render Onboarding::ProfileSetups::PickerFieldComponent.new(
      form: f,
      field: :main_income_source
    ) %>
  </div>

  <div class="form-actions">
    <%= render Ui::ButtonComponent.new(
          text: t('.back'),
          url: onboarding_savings_projections_path,
          variant: :'outline-secondary',
          size: :lg
        ) %>
    <%= render Ui::ButtonComponent.new(
          text: t('.continue'),
          type: :submit,
          variant: :primary,
          size: :lg,
          form: f
        ) %>
  </div>
<% end %>
