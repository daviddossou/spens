<% content_for :title, t('.title') %>

<div class="onboarding-step">
  <header class="onboarding-step-header">
    <p class="onboarding-step-header__eyebrow onboarding-step-header__eyebrow--done">
      <span class="summary-check" aria-hidden="true">✓</span> <%= t('.done') %>
    </p>
  </header>

  <div class="onboarding-step__body">
    <div class="gather-total">
      <p class="gather-total__label"><%= t('.total_label') %></p>
      <p class="gather-total__amount"><%= account_money(@total) %></p>
      <p class="gather-total__count"><%= t('.total_places', count: @accounts.size) %> · <%= t('.spent_today', amount: account_money(@spent)) %></p>
    </div>

    <ul class="gather-list">
      <% @accounts.each do |account| %>
        <% icon, label = picker_icon_and_label(account.name) %>
        <li class="gather-list__row">
          <span class="gather-list__name"><span aria-hidden="true"><%= icon %></span> <%= label %></span>
          <span class="gather-list__balance"><%= account_money(account.balance) %></span>
        </li>
      <% end %>
    </ul>

    <p class="gather-note"><%= t('.note') %></p>

    <div class="onboarding-step__actions">
      <%= button_to t('.enter'), onboarding_summaries_path, method: :patch,
                    class: "btn btn-primary btn-lg btn-full-width onboarding-step__cta" %>
    </div>
  </div>
</div>
