<%
  month_slug = @month.strftime("%Y-%m")
  income = @category.kind == "income"
  subtitle = if @category.parent
    t(".subtitle_child", parent: @category.parent.name)
  elsif @flat_list
    t(".subtitle_unbudgeted")
  elsif @has_children
    t(".subtitle_parent", count: @category.children.size)
  else
    t(".subtitle_#{@category.kind}")
  end
  status_bar = @entry && @editable
  # Month pill: the surrounding months, this one marked, so a category reads across time.
  month_options = (-5..1).map { |offset| @month >> offset }
%>
<% content_for :title, @category.name %>
<% content_for :header do %>
  <%= render Navigation::DetailHeaderComponent.new(back_url: budgets_path(month: month_slug), align: :left,
                                                    title: @category.name, subtitle: subtitle) do |header| %>
    <% header.with_action do %>
      <%= render Ui::ActionMenuComponent.new(label: t('.month_menu_label'), classes: "month-menu", trigger_class: "month-menu__pill", panel_class: "header-menu__panel month-menu__panel") do |menu| %>
<% menu.with_trigger do %>
          <%= l(@month, format: :month_short_year).capitalize %>
          <%= render Ui::IconComponent.new(:chevron_down) %>
        <% end %>

          <% month_options.each do |m| %>
            <%= link_to l(m, format: :month_year).capitalize,
                        category_budgets_path(id: @category.id, month: m.strftime("%Y-%m")),
                        class: "header-menu__item month-menu__item #{'month-menu__item--active' if m == @month}",
                        "aria-current": (m == @month ? "true" : nil) %>
          <% end %>

<% end %>
    <% end %>
  <% end %>
<% end %>

<div class="page-container page-container--narrow">
  <div class="page-content budget-category <%= 'budget-category--with-bar' if status_bar %>">
    <%# Header band: the month's amount, flush with the top bar. With a budget line it
        carries the line's bar and status word for word; without one, the amount and its habit. %>
    <%= render Budgets::CategoryHeroComponent.new(average: @average, category: @category, editable: @editable, entry: @entry, parent_progress: @parent_progress, progress: @progress, total: @total, transactions: @transactions, usual_day: @usual_day, income: income, month_slug: month_slug) %>

    <% if @transactions.any? && @flat_list %>
      <div class="transaction-group__items">
        <% @transactions.each do |transaction| %>
          <%= render TransactionItemComponent.new(transaction: transaction, context: :category, category: @category, subcategory_hint: @has_children, show_date: true) %>
        <% end %>
      </div>
    <% elsif @transactions.any? %>
      <div class="transactions-timeline">
        <% @grouped.each do |date, transactions| %>
          <%= render Transactions::DayGroupComponent.new(date: date, transactions: transactions, category: @category, subcategory_hint: @has_children) %>
        <% end %>
      </div>
    <% else %>
      <%= render Ui::EmptyStateComponent.new(classes: "budget-category__empty") do %>
        <p class="budget-category__empty-title"><%= t(".empty_title") %></p>
        <p class="budget-category__empty-text"><%= t(".empty_text", month: l(@month, format: :month_only)) %></p>
        <% if @editable %>
          <%= render Ui::ButtonComponent.new(
                text: t(".add_#{@category.kind}"), variant: :primary, size: :xl,
                url: new_transaction_path(kind: @category.kind, transaction_type_name: @category.name),
                classes: "budget-category__cta", data: { turbo_frame: "modal" }) %>
        <% end %>
      <% end %>
    <% end %>

    <% if status_bar %>
      <%# The envelope is edited from the proof, not from the settings. %>
      <div class="budget-category__bar">
        <%= render Ui::ButtonComponent.new(
              variant: :"outline-primary", size: :xl, full_width: true,
              url: edit_budget_entry_path(id: @entry.id, return_to: request.fullpath),
              classes: "budget-category__adjust", data: { turbo_frame: "modal" }) do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h10M4 18h6"/></svg>
          <%= t(".adjust_envelope") %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
