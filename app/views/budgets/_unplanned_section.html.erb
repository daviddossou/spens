<%# Hors-plan card (En cours): money that moved outside the plan this month —
    the honest account of what's widening the gap with the hero's projection.
    Recurring off-plan categories offer "Plan it"; one-offs just state themselves.
    (The "One-off" dismiss action is a deferred product decision — see README.) %>
<%
  month_slug = @month.strftime("%Y-%m")
  plan_amount = ->(amount) { amount % 1 == 0 ? amount.to_i : amount }
  prev_month_name = l(@month << 1, format: "%B")

  rows = []
  @unplanned[:expense].each do |type, sums|
    rows << { name: type.name, amount: sums[:amount], recurring: sums[:prev].to_f.positive?,
              path: new_budget_item_path(month: month_slug, kind: "expense", transaction_type_name: type.name, amount: plan_amount.call(sums[:amount])) }
  end
  @unplanned[:income].each do |type, sums|
    rows << { name: type.name, amount: sums[:amount], sign: :in, recurring: sums[:prev].to_f.positive?,
              path: new_budget_item_path(month: month_slug, kind: "income", transaction_type_name: type.name, amount: plan_amount.call(sums[:amount])) }
  end
  @unplanned[:transfers].each do |transfer|
    rows << { name: "#{transfer[:from]&.name} → #{transfer[:to]&.name}", amount: transfer[:amount], sign: :neutral, recurring: false, path: nil }
  end

  expense_total = @unplanned[:expense].values.sum { |s| s[:amount] }
%>

<% if rows.any? %>
  <div class="hors-plan">
    <div class="hors-plan__header">
      <div class="hors-plan__header-text">
        <p class="hors-plan__title"><%= t('budgets.unplanned.card_title_html', amount: money(expense_total)) %></p>
        <p class="hors-plan__subtitle"><%= t('budgets.unplanned.card_subtitle') %></p>
      </div>
      <span class="hors-plan__count" aria-hidden="true"><%= rows.size %></span>
    </div>

    <ul class="hors-plan__list">
      <% rows.each do |row| %>
        <li class="hors-plan__row">
          <div class="hors-plan__row-text">
            <span class="hors-plan__name"><%= row[:name] %></span>
            <span class="hors-plan__meta">
              <% amount_str = money(row[:amount], sign: (row[:sign] == :in ? :always : :auto)) %>
              <% if row[:recurring] %>
                <%= t('budgets.unplanned.meta_recurring_html', amount: amount_str, month: prev_month_name) %>
              <% else %>
                <%= t('budgets.unplanned.meta_once_html', amount: amount_str) %>
              <% end %>
            </span>
          </div>
          <%# "Planifier" is always offered — the user knows better than a
              one-month heuristic whether this will come back. The meta line
              keeps the recurrence info (seen once / already off-plan last month). %>
          <% if row[:path] && !read_only %>
            <%= link_to t('budgets.unplanned.plan_it_pill'), row[:path],
                        class: "hors-plan__action", data: { turbo_frame: "modal" } %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
