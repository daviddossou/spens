<% content_for :title, t('.title') %>

<div class="page-container page-container--narrow budget-page--<%= @mode %>">
  <div class="page-content <%= 'budget-page--with-fab' if @editable %>">
    <nav class="budget-month-nav" aria-label="<%= t('.month_nav_label') %>">
      <%= link_to budgets_path(month: (@month << 1).strftime("%Y-%m")), class: "budget-month-nav__arrow",
                  "aria-label": t('.previous_month') do %>&lsaquo;<% end %>
      <div class="budget-month-nav__heading">
        <h2 class="budget-month-nav__title"><%= l(@month, format: :month_year).capitalize %></h2>
        <p class="budget-month-nav__subtitle">
          <% case @month_position
             when :future %><%= t('.subtitle_plan', count: @days_until) %>
          <% when :current %><%= t('.subtitle_en_cours', day: @day_of_month, total: @days_in_month, remaining: @days_remaining) %>
          <% else %><%= t('.subtitle_bilan', total: @days_in_month) %>
          <% end %>
        </p>
      </div>
      <%= link_to budgets_path(month: (@month >> 1).strftime("%Y-%m")), class: "budget-month-nav__arrow",
                  "aria-label": t('.next_month') do %>&rsaquo;<% end %>
    </nav>

    <%# Viewpoint selector on the SAME month: it never navigates, only changes the
        reading. Modes that have nothing to show for this month are disabled. %>
    <nav class="budget-mode-nav" role="tablist" aria-label="<%= t('.mode_nav_label') %>">
      <% [ :plan, :en_cours, :bilan ].each do |mode| %>
        <% if @allowed_modes.include?(mode) %>
          <%= link_to budgets_path(month: @month.strftime("%Y-%m"), view: mode),
                      role: "tab", "aria-selected": (@mode == mode).to_s,
                      class: "budget-mode-nav__seg#{' budget-mode-nav__seg--active' if @mode == mode}" do %>
            <%= t(".mode_#{mode}") %>
          <% end %>
        <% else %>
          <span class="budget-mode-nav__seg budget-mode-nav__seg--disabled" role="tab" aria-disabled="true"><%= t(".mode_#{mode}") %></span>
        <% end %>
      <% end %>
    </nav>

    <% if @sections.values.flatten.any? %>
      <div class="budget-hero">
        <span class="budget-hero__label">
          <%= t('.hero_label') %> · <span class="budget-hero__suffix"><%= t(".hero_suffix_#{@mode}") %></span>
        </span>
        <span class="budget-hero__value <%= 'budget-hero__value--negative' if @hero_value.negative? %>">
          <%= smart_format_money(@hero_value, current_space.currency, sign: :always) %>
        </span>
        <% if @mode == :plan %>
          <span class="budget-hero__sublabel"><%= t('.hero_flow_html',
                income: smart_format_money(@planned_income, current_space.currency),
                expense: smart_format_money(@planned_expense, current_space.currency)) %></span>
        <% elsif @mode == :en_cours %>
          <span class="budget-hero__sublabel"><%= t('.hero_sub_en_cours_html',
                planned: smart_format_money(@projected_net, current_space.currency),
                offplan: content_tag(:span, smart_format_money(@offplan_net, current_space.currency, sign: :always),
                                     class: ("budget-hero__offplan-amount" if @offplan_net.negative?))) %></span>
        <% else %>
          <span class="budget-hero__sublabel"><%= t('.actual_so_far_html', amount: smart_format_money(@actual_net, current_space.currency, sign: :always)) %></span>
        <% end %>
        <% if @savings_goal.positive? && @mode == :en_cours %>
          <%# Goal bar with a "today" marker: am I pacing to hit the goal by month end? %>
          <% goal_pct = [ [ (@hero_value / @savings_goal * 100).round, 0 ].max, 100 ].min %>
          <% today_pct = [ (@day_of_month.to_f / @days_in_month * 100).round, 100 ].min %>
          <% over = @hero_value >= @savings_goal %>
          <% delta = (@hero_value - @savings_goal).abs %>
          <div class="budget-goalbar">
            <div class="budget-goalbar__track">
              <div class="budget-goalbar__fill" style="width: <%= goal_pct %>%;"></div>
              <div class="budget-goalbar__today" style="left: <%= today_pct %>%;" aria-hidden="true"></div>
            </div>
            <div class="budget-goalbar__legend">
              <span class="<%= 'budget-goalbar__over' if over %>">
                <%= over ? t('.goal_bar_over_html', amount: smart_format_money(@savings_goal, current_space.currency), delta: smart_format_money(delta, current_space.currency)) \
                         : t('.goal_bar_short_html', amount: smart_format_money(@savings_goal, current_space.currency), delta: smart_format_money(delta, current_space.currency)) %>
              </span>
              <span class="budget-goalbar__today-label"><%= t('.today') %></span>
            </div>
          </div>
        <% elsif @savings_goal.positive? && @mode == :plan %>
          <% over = @hero_value >= @savings_goal %>
          <% delta = (@hero_value - @savings_goal).abs %>
          <span class="budget-hero__goal <%= over ? 'budget-hero__goal--on-track' : 'budget-hero__goal--short' %>">
            <%= over ? t('.goal_plan_over_html', amount: smart_format_money(@savings_goal, current_space.currency), delta: smart_format_money(delta, current_space.currency)) \
                     : t('.goal_plan_short_html', amount: smart_format_money(@savings_goal, current_space.currency), delta: smart_format_money(delta, current_space.currency)) %>
          </span>
        <% end %>
      </div>

      <% if @planned_expense_total.positive? && @mode != :bilan %>
        <%= render "vital_confort", mode: @mode %>
      <% end %>

      <%# Off-plan spending sits above the line sections in the live month —
          it's what explains the gap between plan and reality. %>
      <% if @mode == :en_cours %>
        <%= render "unplanned_section", read_only: false %>
      <% end %>

      <%# All four sections always show, each with its total; an empty one states
          itself rather than vanishing, so the shape of the plan stays legible. %>
      <% short_month = l(@month, format: "%B") %>
      <% [ :income, :expense, :transfer, :debt ].each do |section| %>
        <% entries = @sections[section] %>
        <% planned = entries.sum(&:planned_amount) %>
        <% actual = entries.sum { |e| @actuals_by_entry[e] } %>
        <section class="budget-section">
          <div class="budget-section__header">
            <h3 class="budget-section__title"><%= t(".section_#{section}") %></h3>
            <span class="budget-section__total">
              <% if @mode == :plan %>
                <%= smart_format_money(planned, current_space.currency) %>
              <% else %>
                <%= smart_format_money(actual, current_space.currency) %> / <%= smart_format_money(planned, current_space.currency) %>
              <% end %>
            </span>
          </div>
          <% if entries.any? %>
            <div class="budget-section__list">
              <% entries.each do |entry| %>
                <%= render Budgets::EntryRowComponent.new(
                  entry: entry,
                  actual: @actuals_by_entry[entry] || 0,
                  currency: current_space.currency,
                  read_only: !@editable,
                  mode: @mode
                ) %>
              <% end %>
            </div>
          <% else %>
            <p class="budget-section__empty"><%= t(".section_empty_#{section}", month: short_month) %></p>
          <% end %>
        </section>
      <% end %>
    <% else %>
      <% month_name = l(@month, format: "%B").capitalize %>
      <% if @has_items %>
        <%# Lines exist elsewhere, none fall this month. %>
        <div class="budget-void">
          <span class="budget-void__mark" aria-hidden="true"><span class="budget-void__square"></span></span>
          <h3 class="budget-void__title"><%= t('.no_entries_title', month: month_name) %></h3>
          <p class="budget-void__body"><%= t('.no_entries_message', month: month_name) %></p>
          <% if @editable %>
            <%= link_to t('.no_entries_create', month: month_name),
                        new_budget_item_path(month: @month.strftime("%Y-%m")),
                        class: "link-button", data: { turbo_frame: "modal" } %>
          <% end %>
        </div>
      <% else %>
        <%# No plan at all yet — offer ways to start. %>
        <div class="budget-start">
          <h3 class="budget-start__title"><%= t('.empty_title', month: month_name) %></h3>
          <p class="budget-start__body"><%= t('.empty_message') %></p>

          <%# Template starters (Household / From transactions) aren't built yet —
              they all opened a blank form — so the empty state offers the one
              honest action for now. TODO: restore the template picker once the
              starters actually prefill lines. %>
          <div class="budget-start__cta">
            <%= render Ui::ButtonComponent.new(
              text: t('.add_first_item'),
              url: new_budget_item_path(month: @month.strftime("%Y-%m")),
              variant: :primary, size: :lg, full_width: true,
              data: { turbo_frame: "modal" }
            ) %>
          </div>

          <% if @savings_goal.positive? %>
            <p class="budget-start__goal"><%= t('.goal_encart_html', amount: smart_format_money(@savings_goal, current_space.currency)) %></p>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<% if @editable %>
  <%= render Ui::FabComponent.new(url: new_budget_item_path(month: @month.strftime("%Y-%m")), label: t('.add_item')) %>
<% end %>
