<% content_for :title, t('.title') %>

<div class="page-container page-container--narrow budget-page--<%= @mode %>">
  <div class="page-content <%= 'budget-page--with-fab' if @editable %>">
    <%= render Budgets::MonthNavigationComponent.new(day_of_month: @day_of_month, days_in_month: @days_in_month, days_remaining: @days_remaining, days_until: @days_until, month: @month, month_position: @month_position) %>

    <%# Viewpoint selector on the SAME month: it never navigates, only changes the
        reading. Modes that have nothing to show for this month are disabled. %>
    <%= render Ui::SwitcherComponent.new(tag: :nav, css_class: "budget-mode-nav", option_class: "budget-mode-nav__seg", active_class: "budget-mode-nav__seg--active", disabled_class: "budget-mode-nav__seg--disabled",
 current: @mode, role: "tablist", option_role: "tab", aria: { label: t('.mode_nav_label') },
 options: %i[plan live wrap_up].map { |mode| { value: mode, text: t(".mode_#{mode}"), disabled: !@allowed_modes.include?(mode), url: budgets_path(month: @month.strftime("%Y-%m"), view: mode) } }) %>

    <% if @sections.values.flatten.any? %>
      <%= render Budgets::SummaryComponent.new(actual_net: @actual_net, committed_to_goals: @committed_to_goals, free_value: @free_value, hero_value: @hero_value, mode: @mode, offplan_net: @offplan_net, planned_expense: @planned_expense, planned_income: @planned_income, projected_net: @projected_net) %>

      <% if @planned_expense_total.positive? && @mode != :wrap_up %>
        <%= render Budgets::VitalConfortComponent.new(actual_confort: @actual_confort, actual_vital: @actual_vital, days_remaining: @days_remaining, planned_confort: @planned_confort, planned_expense_total: @planned_expense_total, planned_vital: @planned_vital, reste_a_depenser: @reste_a_depenser, mode: @mode) %>
      <% end %>

      <%# Off-plan spending sits above the line sections — it's what explains
          the gap between plan and reality. A closed month only states it. %>
      <% if @mode != :plan %>
        <%= render Budgets::UnplannedSectionComponent.new(month: @month, unplanned: @unplanned, read_only: @mode == :wrap_up) %>
      <% end %>

      <%# All four sections always show, each with its total; an empty one states
          itself rather than vanishing, so the shape of the plan stays legible. %>
      <% short_month = l(@month, format: "%B") %>
      <% [ :income, :expense, :transfer, :debt ].each do |section| %>
        <% entries = @sections[section] %>
        <% planned = entries.sum(&:planned_amount) %>
        <% actual = entries.sum { |e| @actuals_by_entry[e] } %>
        <%= render Budgets::SectionComponent.new(actuals_by_entry: @actuals_by_entry, editable: @editable, mode: @mode, section: section, entries: entries, planned: planned, actual: actual, short_month: short_month) %>
      <% end %>
    <% else %>
      <% month_name = l(@month, format: "%B").capitalize %>
      <% if @has_items %>
        <%# Lines exist elsewhere, none fall this month. %>
        <%= render Ui::EmptyStateComponent.new(classes: "budget-void") do %>
          <span class="budget-void__mark" aria-hidden="true"><span class="budget-void__square"></span></span>
          <h3 class="budget-void__title"><%= t('.no_entries_title', month: month_name) %></h3>
          <p class="budget-void__body"><%= t('.no_entries_message', month: month_name) %></p>
          <% if @editable %>
            <%= link_to t('.no_entries_create', month: month_name),
                        new_budget_item_path(month: @month.strftime("%Y-%m")),
                        class: "link-button", data: { turbo_frame: "modal" } %>
          <% end %>
        <% end %>
      <% else %>
        <%# No plan at all yet — offer ways to start. %>
        <%= render Ui::EmptyStateComponent.new(classes: "budget-start") do %>
          <h3 class="budget-start__title"><%= t('.empty_title', month: month_name) %></h3>
          <p class="budget-start__body"><%= t('.empty_message') %></p>

          <%# Template starters (Household / From transactions) aren't built yet —
              they all opened a blank form — so the empty state offers the one
              honest action for now. TODO: restore the template picker once the
              starters actually prefill lines. %>
          <div class="budget-start__cta">
            <%= render Ui::ButtonComponent.new(
              text: t('.add_first_item'),
              url: new_budget_item_path(month: @month.strftime("%Y-%m")),
              variant: :primary, size: :lg, full_width: true,
              data: { turbo_frame: "modal" }
            ) %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>

<% if @editable %>
  <%= render Ui::FabComponent.new(url: new_budget_item_path(month: @month.strftime("%Y-%m")), label: t('.add_item')) %>
<% end %>
