<% content_for :page_title, t('.page_title') %>
<%
  range = @period.range
  range_label = @period.month? ? "#{range.begin.day} – #{l([ Date.current, range.end ].min, format: :day_month)}" \
                               : "#{l(range.begin, format: :day_month)} – #{l(range.end, format: :day_month)}"
  plan = @spending.plan
  split = @spending.essential_split
  comparison = @spending.comparison
%>

<%# Analyses is a destination you come back from, not a tab you live in: it
    takes the detail bar, and the range you are reading rides in it. %>
<% content_for :header do %>
  <%= render Navigation::DetailHeaderComponent.new(
        back_url: dashboard_path, title: t('.page_title'), subtitle: range_label) %>
<% end %>

<div class="page-container page-container--narrow">
  <div class="page-content analyses">
    <%= render Analytics::PeriodSelectorComponent.new(period: @period, range: range) %>

    <% if @spending.spent_total.zero? && @spending.lent_total.zero? %>
      <%= render Ui::EmptyStateComponent.new(classes: "empty-state") do %>
        <p class="analyses-empty__title"><%= t('.empty_title') %></p>
        <p class="analyses-empty__message"><%= t('.empty_message') %></p>
      <% end %>
    <% else %>
      <h2 class="analyses-section__title"><%= t('.section_spent') %></h2>

      <%= render Analytics::SpendingSummaryComponent.new(period: @period, spending: @spending, range: range, comparison: comparison, plan: plan, split: split) %>

    <%= render Analytics::RhythmChartComponent.new(period: @period, rhythm: @rhythm) %>

      <%= render Analytics::BudgetVarianceComponent.new(period: @period, spending: @spending, plan: plan) %>
    <% end %>

    <%= render Analytics::DebtSummaryComponent.new(relations: @relations) %>

    <%# Section 3 — what you set aside: the habit, the goals' arrival dates,
        and where the money sits. Each block exists only if its data does. %>
    <% show_saved = @set_aside.any_account? || @goals.any? || @accounts.any? %>
    <% if show_saved %>
      <h2 class="analyses-section__title"><%= t('.section_saved') %></h2>

    <%= render Analytics::SavingsHistoryComponent.new(set_aside: @set_aside) %>

    <%= render Analytics::GoalsComponent.new(goals: @goals) %>

    <%= render Analytics::AccountDistributionComponent.new(accounts: @accounts) %>

      <%= link_to budgets_path, class: "analyses-footer-cta", data: { turbo_frame: "_top" } do %>
        <span class="analyses-footer-cta__body">
          <span class="analyses-footer-cta__title"><%= t('.adjust_budget') %></span>
          <span class="analyses-footer-cta__sub"><%= t('.adjust_budget_sub') %></span>
        </span>
        <span aria-hidden="true">›</span>
      <% end %>
    <% end %>
  </div>
</div>
