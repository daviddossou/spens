<% if url.present? %>
  <%= link_to url, class: root_class do %>
    <div class="commitment-card__head">
      <span class="commitment-card__name"><%= title %></span>
      <% if target_set? && settled? %>
        <span class="commitment-card__badge"><%= complete_label %></span>
      <% else %>
        <span class="commitment-card__remaining"><%= target_set? ? formatted_remaining : formatted_current_value %><span class="commitment-card__remaining-label"><%= target_set? ? remaining_label : progress_label %></span></span>
      <% end %>
    </div>
    <% if target_set? %>
      <%= bar if show_bar? %>
      <%= meta %>
    <% elsif no_target_label.present? %>
      <div class="commitment-card__meta commitment-card__meta--no-target"><%= no_target_label %></div>
    <% end %>
  <% end %>
<% else %>
  <div class="<%= root_class %>">
    <% if target_set? && settled? %>
      <span class="commitment-card__badge"><%= complete_label %></span>
    <% else %>
      <div class="commitment-card__hero">
        <span class="commitment-card__amount"><%= target_set? ? formatted_remaining : formatted_current_value %></span><span class="commitment-card__remaining-label"><%= target_set? ? remaining_label : progress_label %></span>
      </div>
    <% end %>
    <% if target_set? %>
      <% if show_bar? %>
        <div class="commitment-card__bar-row">
          <%= bar %>
          <span class="commitment-card__pct"><%= percentage %>%</span>
        </div>
      <% end %>
      <div class="commitment-card__progress"><%= progress_summary %></div>
    <% elsif no_target_label.present? %>
      <div class="commitment-card__progress commitment-card__progress--no-target"><%= no_target_label %></div>
    <% end %>
  </div>
<% end %>
