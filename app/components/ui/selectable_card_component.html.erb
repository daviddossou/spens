<% if native_radio %>
  <%= tag.label class: css_class do %>
    <% if form %>
      <%= form.radio_button field, item_value, input_options %>
    <% else %>
      <%= radio_button_tag field, item_value, selected?, input_options %>
    <% end %>
    <%= tag.span item_name, class: "#{css_class}__title" %>
    <%= tag.span item_description, class: "#{css_class}__sub" if item_description %>
  <% end %>
<% else %>
<%= content_tag :div, **final_html_options do %>
  <% unless link_mode? %>
    <% if multiple? %>
      <%= render Forms::CheckboxFieldComponent.new(**input_field_options) %>
    <% else %>
      <%= render Forms::RadioButtonFieldComponent.new(**input_field_options) %>
    <% end %>
  <% end %>

  <div class="<%= content_section_classes %>">
    <h4><%= item_name %></h4>
    <% if item_description %>
      <p class="<%= description_classes %>"><%= item_description %></p>
    <% end %>

    <% if render_visual_checkbox? %>
      <div class="<%= checkbox_section_classes %>">
        <svg class="checkmark" viewBox="0 0 24 24">
          <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
        </svg>
      </div>
    <% end %>
  </div>
<% end %>
<% end %>
