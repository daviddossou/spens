<%= content_tag :div, **final_html_options do %>
  <% if show_bar %>
    <%= render Ui::ProgressBarComponent.new(percentage: calculated_percentage) %>
  <% end %>
  <% if labels && steps.any? %>
    <div class="step-labels">
      <% steps.each do |step| %>
        <span class="<%= step_classes(step) %>"><%= step_label(step) %></span>
      <% end %>
    </div>
  <% end %>
<% end %>
