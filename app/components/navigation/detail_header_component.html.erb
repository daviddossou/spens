<header class="app-header app-header--detail <%= 'app-header--detail-left' if align == :left %>">
  <div class="app-header__inner">
    <div class="app-header__left">
      <%= link_to back_url, class: "app-header__back",
            aria: { label: back_label || t("navigation.header.back") } do %>
        <%= render Ui::IconComponent.new(:chevron_left) %>
      <% end %>
    </div>

    <div class="app-header__center">
      <h1 class="app-header__title"><%= title %></h1>
      <% if subtitle.present? %>
        <p class="app-header__subtitle"><%= subtitle %></p>
      <% end %>
    </div>

    <div class="app-header__right">
      <%= action if action? %>
    </div>
  </div>
</header>
