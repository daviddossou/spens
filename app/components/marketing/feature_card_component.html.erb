<button type="button" class="landing-feat" id="landing-feat-<%= i %>"
        data-landing--features-target="card"
        data-action="landing--features#select"
        data-poster="<%= image_path("landing/#{feature_shots[i]}.png") %>"
        data-webm="<%= asset_path("landing/#{feature_shots[i]}.webm") %>"
        data-mp4="<%= asset_path("landing/#{feature_shots[i]}.mp4") %>"
        aria-expanded="false" aria-controls="landing-feat-media-<%= i %>">
  <div class="landing-feat__num" aria-hidden="true"><%= Kernel.format("%02d", i + 1) %></div>
  <div class="landing-feat__title"><%= card[:title] %></div>
  <div class="landing-feat__body"><%= card[:body] %></div>
  <div class="landing-feat__media" id="landing-feat-media-<%= i %>">
    <div class="landing-feat__media-inner">
      <span class="landing-shot"><video data-landing--features-target="cardVideo" muted loop playsinline preload="none" aria-label="<%= card[:title] %>"></video></span>
    </div>
  </div>
</button>
