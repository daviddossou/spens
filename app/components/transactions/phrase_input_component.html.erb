<div class="phrase-band">
  <div class="phrase-band__field"
       data-controller="dictation"
       data-dictation-lang-value="<%= I18n.locale == :fr ? 'fr-FR' : 'en-US' %>"
       data-dictation-idle-label-value="<%= t('transactions.new.dictate') %>"
       data-dictation-listening-label-value="<%= t('transactions.new.dictating') %>">
    <svg class="phrase-band__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8L12 3zM5 17l.7 1.8L7.5 19.5l-1.8.7L5 22l-.7-1.8L2.5 19.5l1.8-.7L5 17z"/>
    </svg>
    <%= text_field_tag :text, @text,
          id: "phrase",
          form: "transaction-form",
          class: "phrase-band__input",
          autofocus: true,
          autocomplete: "off",
          autocapitalize: "off",
          enterkeyhint: "done",
          placeholder: t("transactions.new.phrase_placeholder_#{phrase_context_key}"),
          aria: { label: t('transactions.new.phrase_label') },
          data: { phrase_fill_target: "input", dictation_target: "input",
                  action: "input->phrase-fill#type keydown->phrase-fill#submitOnEnter" } %>
    <% if statement_import? %>
    <div class="phrase-band__import" data-controller="statement-entry">
      <button type="button" class="phrase-band__photo" aria-haspopup="dialog"
              aria-label="<%= t('statement_imports.entry.button') %>"
              data-statement-entry-target="button" data-action="statement-entry#open">
        <%= render Ui::IconComponent.new(:photo, stroke_width: 1.6) %>
        <%= render Ui::ProBadgeComponent.new(floating: true) %>
      </button>
      <dialog class="action-sheet" aria-labelledby="statement-entry-title"
              data-statement-entry-target="dialog"
              data-action="click->statement-entry#backdrop close->statement-entry#closed">
        <%= form_with url: statement_imports_path, multipart: true, class: "action-sheet__form",
              data: { turbo_frame: "_top", statement_entry_target: "form" } do %>
          <div class="action-sheet__group">
            <div class="action-sheet__head">
              <h3 class="action-sheet__title" id="statement-entry-title">
                <%= t('statement_imports.title') %> <%= render Ui::ProBadgeComponent.new %>
              </h3>
              <p class="action-sheet__text"><%= t('statement_imports.entry.subtitle') %></p>
              <span class="launch-pill"><%= t('statement_imports.free_during_launch') %></span>
            </div>
            <label class="action-sheet__item">
              <%= render Ui::IconComponent.new(:photo, stroke_width: 1.6) %>
              <span class="action-sheet__label"><%= t('statement_imports.entry.gallery') %></span>
              <span class="action-sheet__meta"><%= t('statement_imports.entry.max', count: StatementImport::MAX_CAPTURES) %></span>
              <input type="file" name="captures[]" accept="image/*" multiple hidden data-origin="gallery" data-action="change->statement-entry#submit">
            </label>
            <label class="action-sheet__item">
              <%= render Ui::IconComponent.new(:camera, stroke_width: 1.6) %>
              <span class="action-sheet__label"><%= t('statement_imports.entry.camera') %></span>
              <input type="file" name="captures[]" accept="image/*" capture="environment" hidden data-origin="camera" data-action="change->statement-entry#submit">
            </label>
            <label class="action-sheet__item">
              <%= render Ui::IconComponent.new(:document, stroke_width: 1.6) %>
              <span class="action-sheet__label"><%= t('statement_imports.entry.pdf') %></span>
              <input type="file" name="captures[]" accept="application/pdf" multiple hidden data-origin="pdf" data-action="change->statement-entry#submit">
              <input type="hidden" name="origin" data-statement-entry-target="origin">
            </label>
            <p class="action-sheet__status" data-statement-entry-target="status" hidden aria-live="polite"><%= t('statement_imports.entry.sending') %></p>
          </div>
          <button type="button" class="action-sheet__cancel" data-action="statement-entry#close"><%= t('statement_imports.entry.cancel') %></button>
        <% end %>
      </dialog>
    </div>
    <% end %>
    <%# Only shown where the browser exposes the phone's speech recognition. The Android
        app's WebView declares the API but can't run it: no button there until a native
        bridge exists. %>
    <% unless turbo_native_app? %>
    <button type="button" class="phrase-band__mic" hidden
            aria-label="<%= t('transactions.new.dictate') %>" aria-pressed="false"
            data-dictation-target="button" data-action="dictation#toggle">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15a3 3 0 003-3V6a3 3 0 10-6 0v6a3 3 0 003 3z"/>
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-14 0M12 18v3m-3 0h6"/>
      </svg>
    </button>
    <% end %>
  </div>
  <p class="phrase-band__help" data-phrase-fill-target="help"<%= " hidden" if @text.present? %>><%= statement_import? ? t('transactions.new.phrase_help_with_import_html', count: StatementImport::MAX_CAPTURES) : t('transactions.new.phrase_help') %></p>
  <p class="phrase-band__status" data-phrase-fill-target="status" hidden aria-live="polite"></p>
</div>
