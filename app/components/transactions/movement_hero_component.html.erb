<div class="movement-hero">
  <div class="movement-hero__icon transaction-item__icon <%= "transaction-item__icon--#{row.family}" %>" aria-hidden="true">
    <%= TransactionIconService.icon_svg_by_name(row.icon_name) %>
  </div>
  <%# The amount is the fastest way into the full edit form. %>
  <%= link_to edit_transaction_path(id: @transaction.id),
        class: "movement-hero__amount#{' movement-hero__amount--muted' if row.muted?}",
        aria: { label: t('transactions.show.edit') }, data: { turbo_frame: "modal" } do %>
    <%= money(@transaction.amount, sign: row.show_sign? ? :always : :none) %>
  <% end %>
  <% if row.subtitle.present? %>
    <p class="movement-hero__subtitle"><%= row.subtitle %></p>
  <% end %>
  <% if @transaction.note.present? %>
    <p class="movement-hero__note">&laquo;&nbsp;<%= @transaction.note %>&nbsp;&raquo;</p>
  <% end %>
</div>
