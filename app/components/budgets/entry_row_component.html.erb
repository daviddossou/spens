<% row_body = capture do %>
  <div class="budget-row__main">
    <div class="budget-row__heading">
      <span class="budget-row__name-row">
        <% if leading_icon_kind %>
          <span class="budget-row__icon budget-row__icon--<%= entry.kind %>" aria-hidden="true"><%= helpers.transaction_icon_svg(leading_icon_kind) %></span>
        <% end %>
        <span class="budget-row__name"><%= entry.display_name %></span>
        <% if exception? %>
          <span class="budget-row__exception-pill"><%= t("budgets.row.exception_pill") %></span>
        <% end %>
      </span>
      <% if meta_line.present? %>
        <span class="budget-row__meta-line"><%= meta_line %></span>
      <% end %>
    </div>
    <div class="budget-row__amounts">
      <% if plan_mode? %>
        <span class="budget-row__planned-only <%= 'budget-row__amount--income' if incoming_debt? %>"><%= formatted_planned %></span>
      <% else %>
        <span class="budget-row__actual <%= 'budget-row__actual--over' if over? %> <%= 'budget-row__amount--income' if incoming_debt? %>"><%= formatted_actual %></span>
        <span class="budget-row__planned">/ <%= formatted_planned %></span>
      <% end %>
      <% if detail_path %>
        <%= render Ui::IconComponent.new(:chevron_right, classes: "budget-row__chevron") %>
      <% end %>
    </div>
  </div>

  <% unless plan_mode? %>
    <%= render Ui::ProgressBarComponent.new(percentage: percentage, width: bar_percentage, classes: "budget-row__bar", fill_class: bar_class, label: "#{entry.display_name}: #{percentage}%") %>

    <div class="budget-row__meta">
      <span class="budget-row__status <%= 'budget-row__status--paid' if celebrate? %>">
        <% if celebrate? %><span aria-hidden="true">✓</span><% end %>
        <%= status_label %><% if carried? %> <span class="budget-row__carried">· <%= t("budgets.row.carried_html", amount: formatted_carried) %></span><% end %>
        <% if over? %>
          <span class="budget-row__over-label">· ↑ <%= t("budgets.row.over_by_html", amount: formatted_overage) %></span>
        <% elsif !fulfilled? && actual < planned %>
          <span class="budget-row__left-label">· <%= t("budgets.row.#{left_label_key}", amount: helpers.money(planned - actual, currency)) %></span>
        <% end %>
      </span>
      <% if essential_label.present? %>
        <%= render Ui::BadgeComponent.new(essential_label, classes: "budget-row__tag") %>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if detail_path %>
  <%= link_to detail_path, class: "budget-row budget-row--link" do %>
    <%= row_body %>
  <% end %>
<% elsif read_only %>
  <div class="budget-row"><%= row_body %></div>
<% else %>
  <%= link_to edit_budget_entry_path(id: entry.id), class: "budget-row budget-row--link", data: { turbo_frame: "modal" } do %>
    <%= row_body %>
  <% end %>
<% end %>
