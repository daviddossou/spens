<section class="budget-category__hero">
  <div class="budget-category__amounts">
    <span class="budget-category__amount <%= 'budget-category__amount--over' if @progress&.over? %> <%= 'budget-category__amount--income' if income && @total.positive? %> <%= 'budget-category__amount--empty' if @total.zero? %>">
      <%= money(@total, sign: (income ? :always : :none)) %>
    </span>
    <% if @progress %>
      <span class="budget-category__planned"><%= t("budgets.categories.show.planned_html", amount: money(@progress.planned)) %></span>
    <% else %>
      <span class="budget-category__count"><%= t("budgets.categories.show.transactions", count: @transactions.size) %></span>
    <% end %>
  </div>

  <% if @progress %>
    <%= render Ui::ProgressBarComponent.new(percentage: @progress.percentage, width: @progress.bar_percentage, classes: "budget-row__bar", fill_class: @progress.bar_class, label: "#{@category.name}: #{@progress.percentage}%") %>
    <div class="budget-category__status-line">
      <span class="budget-row__status <%= 'budget-row__status--paid' if @progress.celebrate? %>">
        <% if @progress.celebrate? %><span aria-hidden="true">✓</span><% end %>
        <%= @progress.status_label %>
        <% if @progress.over? %>
          <span class="budget-row__over-label">· ↑ <%= t("budgets.row.over_by_html", amount: money(@progress.overage)) %></span>
        <% elsif @progress.fulfilled? && @progress.overage.positive? %>
          <span class="budget-category__above-label">· <%= t("budgets.categories.show.above_plan_html", amount: money(@progress.overage)) %></span>
        <% elsif !@progress.fulfilled? %>
          <span class="budget-row__left-label">· <%= t("budgets.row.#{@progress.left_label_key}", amount: money(@progress.remaining)) %></span>
        <% end %>
      </span>
      <% if @usual_day %>
        <span class="budget-category__count"><%= t("budgets.categories.show.usual_day_#{@category.kind}", day: (I18n.locale == :en ? @usual_day.ordinalize : @usual_day)) %></span>
      <% else %>
        <span class="budget-category__count"><%= t("budgets.categories.show.transactions", count: @transactions.size) %></span>
      <% end %>
    </div>
  <% end %>

  <% if @average.positive? %>
    <p class="budget-category__average">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 17l6-6 4 4 8-8"/></svg>
      <%= t("budgets.categories.show.average_html", amount: money(@average)) %>
    </p>
  <% end %>

  <% if @parent_progress %>
    <%# Counted on the parent's line: no bar here, a link up instead. %>
    <%= link_to category_budgets_path(id: @category.parent.id, month: month_slug), class: "budget-category__parent-link" do %>
      <span class="budget-category__parent-text">
        <span class="budget-category__parent-label"><%= t("budgets.categories.show.counts_in_html", parent: content_tag(:strong, @category.parent.name)) %></span>
        <span class="budget-category__parent-amounts <%= 'budget-category__parent-over' if @parent_progress.over? %>"><%= money(@parent_progress.actual) %> / <%= money(@parent_progress.planned) %></span>
      </span>
      <span class="budget-category__parent-chevron" aria-hidden="true">&rsaquo;</span>
    <% end %>
  <% elsif @entry.nil? && @editable %>
    <%= render Ui::ButtonComponent.new(
          text: t("budgets.categories.show.create_envelope"), variant: :"outline-primary", size: :lg,
          url: new_budget_item_path(month: month_slug, kind: @category.kind, transaction_type_name: @category.name,
                                    amount: (@average.positive? ? @average : @total).round),
          classes: "budget-category__create", data: { turbo_frame: "modal" }) %>
  <% end %>
</section>
