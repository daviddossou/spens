<div class="budget-hero">
  <span class="budget-hero__label">
    <%= t('budgets.index.hero_label') %> · <span class="budget-hero__suffix"><%= t("budgets.index.hero_suffix_#{@mode}") %></span>
  </span>
  <span class="budget-hero__value <%= 'budget-hero__value--negative' if @hero_value.negative? %>">
    <%= money(@hero_value, sign: :always) %>
  </span>
  <% if @mode == :plan %>
    <span class="budget-hero__sublabel"><%= t('budgets.index.hero_flow_html',
          income: money(@planned_income),
          expense: money(@planned_expense)) %></span>
  <% elsif @mode == :live %>
    <span class="budget-hero__sublabel"><%= t('budgets.index.hero_sub_live_html',
          planned: money(@projected_net),
          offplan: content_tag(:span, money(@offplan_net, sign: :always),
                               class: ("budget-hero__offplan-amount" if @offplan_net.negative?))) %></span>
  <% elsif @offplan_net.zero? %>
    <span class="budget-hero__sublabel"><%= t('budgets.index.actual_so_far_html', amount: money(@actual_net, sign: :always)) %></span>
  <% else %>
    <span class="budget-hero__sublabel"><%= t('budgets.index.hero_sub_wrap_up_html',
          planned: money(@actual_net, sign: :always),
          offplan: content_tag(:span, money(@offplan_net, sign: :always),
                               class: ("budget-hero__offplan-amount" if @offplan_net.negative?))) %></span>
  <% end %>

  <%# Money promised to a savings account is kept, so it stays inside the
      hero — but it is no longer free, and that is the number you cannot
      read anywhere else. %>
  <% if @committed_to_goals.positive? %>
    <p class="budget-hero__committed">
      <%= t('budgets.index.committed_html', committed: money(@committed_to_goals), free: money(@free_value)) %>
    </p>
  <% end %>
</div>
