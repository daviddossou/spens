<%# Vital / Confort: how the month's expenses split between the floor you can't
    skip and what's adjustable. Plan shows one planned bar; En cours shows the
    two tracked against plan plus what's left to spend. %>
<% pct = ->(part, whole) { whole.to_f.positive? ? [ (part.to_f / whole * 100).round, 100 ].min : 0 } %>
<div class="vital-confort">
  <div class="vital-confort__header">
    <h3 class="vital-confort__title"><%= t('budgets.index.vital_confort_title') %></h3>
    <span class="vital-confort__total">
      <% if mode == :plan %>
        <%= t('budgets.index.vital_confort_total_html', amount: money(@planned_expense_total)) %>
      <% else %>
        <%= t('budgets.index.vital_confort_progress_html',
              actual: money(@actual_vital + @actual_confort),
              planned: money(@planned_expense_total)) %>
      <% end %>
    </span>
  </div>

  <% if mode == :plan %>
    <%# One bar, split vital (indigo) vs confort (light indigo). %>
    <div class="vital-confort__bar" role="img"
         aria-label="<%= t('budgets.index.vital_label') %> <%= money(@planned_vital) %>, <%= t('budgets.index.confort_label') %> <%= money(@planned_confort) %>">
      <div class="vital-confort__bar-fill vital-confort__bar-fill--vital" style="width: <%= pct.call(@planned_vital, @planned_expense_total) %>%;"></div>
      <div class="vital-confort__bar-fill vital-confort__bar-fill--confort" style="width: <%= pct.call(@planned_confort, @planned_expense_total) %>%;"></div>
    </div>
    <div class="vital-confort__legend">
      <span class="vital-confort__key vital-confort__key--vital">
        <span class="vital-confort__dot"></span><%= t('budgets.index.vital_label') %>
        <strong><%= money(@planned_vital) %></strong>
      </span>
      <span class="vital-confort__key vital-confort__key--confort">
        <span class="vital-confort__dot"></span><%= t('budgets.index.confort_label') %>
        <strong><%= money(@planned_confort) %></strong>
      </span>
    </div>
  <% else %>
    <%# Two tracked bars: vital, then confort. %>
    <% [ [ :vital, @actual_vital, @planned_vital ], [ :confort, @actual_confort, @planned_confort ] ].each do |key, actual, planned| %>
      <div class="vital-confort__track">
        <div class="vital-confort__track-head">
          <span class="vital-confort__track-label"><%= t("budgets.index.#{key}_label") %></span>
          <span class="vital-confort__track-amounts">
            <strong><%= money(actual) %></strong>
            <span class="vital-confort__track-planned">/ <%= money(planned) %></span>
          </span>
        </div>
        <div class="vital-confort__bar">
          <div class="vital-confort__bar-fill vital-confort__bar-fill--<%= key %>" style="width: <%= pct.call(actual, planned) %>%;"></div>
        </div>
      </div>
    <% end %>

    <div class="vital-confort__footer">
      <span class="vital-confort__reste-label"><%= t('budgets.index.reste_label') %></span>
      <span class="vital-confort__reste-value"><%= money(@reste_a_depenser) %></span>
      <% if @days_remaining.to_i.positive? && @reste_a_depenser.positive? %>
        <span class="vital-confort__reste-rate"><%= t('budgets.index.per_day_html', amount: money((@reste_a_depenser / @days_remaining).round)) %></span>
      <% end %>
    </div>
  <% end %>
</div>
