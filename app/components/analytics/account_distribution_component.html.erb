<% if @accounts.any? %>
  <div class="analyses-card">
    <p class="analyses-card__title">
      <%= t('analytics.index.accounts_title') %>
      <%= link_to t('analytics.index.accounts_link'), accounts_path, class: "analyses-card__link", data: { turbo_frame: "_top" } %>
    </p>
    <%= render Analytics::DistributionComponent.new(rows: @accounts.map { |account| [ account.name, account.balance ] }) %>
  </div>
<% end %>
