<%= link_to transaction_path(locale: I18n.locale, id: transaction.id),
            class: "transaction-item",
            data: { turbo_frame: "_top" },
            aria_label: "#{row.title}: #{display_amount(row, transaction)}" do %>
  <div class="transaction-item__content">
    <!-- Left side: family icon, composed title + one subtitle -->
    <div class="transaction-item__left">
      <div class="transaction-item__info">
        <div class="transaction-item__icon <%= icon_class %>" aria-hidden="true">
          <%= icon_svg %>
        </div>

        <div class="transaction-item__details">
          <p class="transaction-item__type"><%= row.title %></p>
          <% if row.subtitle.present? %>
            <p class="transaction-item__account"><%= row.subtitle %></p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Right side: amount (dark, or muted for neutral) and chevron -->
    <div class="transaction-item__right">
      <div class="transaction-item__amount-container">
        <p class="transaction-item__amount <%= amount_class %>">
          <%= display_amount(row, transaction) %>
        </p>
      </div>
      <svg class="transaction-item__chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </div>
  </div>

  <!-- A provider fee, nested under its parent -->
  <% if fee_row %>
    <div class="transaction-item__fee">
      <span class="transaction-item__fee-title">
        <span class="transaction-item__fee-arrow" aria-hidden="true">&#8627;</span>
        <%= fee_row.title %>
      </span>
      <span class="transaction-item__fee-amount"><%= display_amount(fee_row, transaction.fee) %></span>
    </div>
  <% end %>

  <!-- Note indicator if present -->
  <% if transaction.note.present? %>
    <div class="transaction-item__note">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/>
      </svg>
      <%= t('home.dashboard.has_note') %>
    </div>
  <% end %>
<% end %>
