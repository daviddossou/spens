<div class="debt-hero debt-hero--<%= @relation.net_direction %>">
  <p class="debt-hero__label"><%= t("debts.hero.#{@relation.net_direction}", name: @debt.name) %></p>
  <p class="debt-hero__amount"><%= money(@relation.net_amount) %></p>
  <p class="debt-hero__progress"><%= t("debts.show.net_hero_sub") %></p>
  <div class="debt-subtotals">
    <div class="debt-subtotals__cell">
      <span class="debt-subtotals__label"><%= t("debts.show.subtotal_owed") %></span>
      <span class="debt-subtotals__value debt-subtotals__value--lent"><%= money(@relation.owed_to_me) %></span>
    </div>
    <div class="debt-subtotals__divider"></div>
    <div class="debt-subtotals__cell">
      <span class="debt-subtotals__label"><%= t("debts.show.subtotal_i_owe") %></span>
      <span class="debt-subtotals__value debt-subtotals__value--borrowed"><%= money(@relation.i_owe) %></span>
    </div>
  </div>
</div>
