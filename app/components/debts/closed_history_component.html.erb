<details class="debts-closed" <%= "open" if params[:closed].present? %>>
  <summary class="debts-closed__summary">
    <span class="debts-closed__check" aria-hidden="true">
      <%= render Ui::IconComponent.new(:check, stroke_width: 2.5) %>
    </span>
    <span class="debts-closed__label">
      <%= t("debts.index.closed_count", count: closed_groups.size) %>
      <span class="debts-closed__breakdown"><%= closed_debts_breakdown(@closed_debts) %></span>
    </span>
    <span class="debts-closed__chevron" aria-hidden="true">
      <%= render Ui::IconComponent.new(:chevron_down) %>
    </span>
  </summary>
  <div class="debts-closed__list">
    <%# One block per person: the name once, then each settled debt under it
        (still clickable to its own page and history). %>
    <% closed_groups.each do |person_debts| %>
      <div class="debt-closed-group">
        <% if person_debts.size > 1 %>
          <span class="debt-closed-group__head">
            <%# Prefer the best-cased spelling of the person's name. %>
            <span class="debt-closed-group__name"><%= person_debts.map(&:name).max_by { |n| n.count("A-Z") } %></span>
            <span class="debt-closed-group__count"><%= t('debts.index.closed_group_count', count: person_debts.size) %></span>
          </span>
        <% end %>
        <% person_debts.each do |debt| %>
          <%= link_to debt_path(id: debt.id), class: "debt-closed-row#{' debt-closed-row--grouped' if person_debts.size > 1}" do %>
            <span class="debt-closed-row__main">
              <span class="debt-closed-row__name">
                <% if person_debts.size == 1 %><%= debt.name %><% end %>
                <% if debt.written_off? %>
                  <%= render Ui::BadgeComponent.new(closed_debt_short_tag(debt), classes: "debt-closed-row__tag") %>
                <% end %>
              </span>
              <span class="debt-closed-row__sub">
                <% if person_debts.size > 1 %><%= t("debts.index.closed_direction.#{debt.direction}") %> · <% end %><%= closed_debt_row_subtitle(debt) %>
              </span>
            </span>
            <span class="debt-closed-row__amount <%= 'debt-closed-row__amount--struck' if debt.written_off? %>">
              <%= money(debt.total_lent) %>
            </span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</details>
