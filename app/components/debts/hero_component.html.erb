<div class="debt-hero debt-hero--<%= direction_key %>">
  <p class="debt-hero__label"><%= t("debts.hero.#{direction_key}", name: @debt.name) %></p>
  <p class="debt-hero__amount"><%= money(remaining) %></p>
  <% if target_set? %>
    <p class="debt-hero__progress">
      <%= t("debts.hero.progress_html", repaid: money(@debt.total_reimbursed), total: money(@debt.total_lent)) %>
    </p>
    <div class="debt-hero__bar-row">
      <%= render Ui::ProgressBarComponent.new(percentage: percentage, classes: "debt-hero__bar", fill_class: "debt-hero__bar-fill") %>
      <span class="debt-hero__pct"><%= percentage %> %</span>
    </div>
  <% end %>
</div>
